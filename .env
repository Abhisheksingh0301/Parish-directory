# ---------------------------------------------------------------
# Parish Directory — configuration for THIS install.
#
# This file is gitignored: it holds the session secret, and each
# church's copy has its own. Never commit it or share it.
# ---------------------------------------------------------------

# Port the server listens on.
PORT=3000

# Where the SQLite database and uploaded photos are kept.
# Everything this parish owns lives in this one folder — back it up.
DATA_DIR=./data

# Signs the session cookie. Generated for this install.
# Changing it signs everybody out. To rotate it:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=0e55cc72da74f763a3ca10355d042cb24dc43ccdbea839f875324f77a12a9d085e3ddc1d158bf19332578281351c486e

# Switch to "production" when deploying.
NODE_ENV=development

# Set to 1 when running behind a reverse proxy (nginx, Caddy, a PaaS)
# that terminates HTTPS, so secure cookies work correctly.
TRUST_PROXY=0

# Forces `Secure` on the session cookie (HTTPS only). Left blank, it
# switches on by itself when NODE_ENV=production.
SECURE_COOKIES=

# The password every family login is created with. One shared value on
# purpose: the parish sends it to everybody in a single email, along with
# the comma-separated address list from the families page. Anyone still on
# it is reminded to choose their own. Changing it here affects only logins
# created afterwards.
DEFAULT_USER_PASSWORD=Churchmembers@2026

# Used only when the database is first created. After that, edit these
# in the app under Settings — changing them here has no effect.
PARISH_NAME=Your Parish Church, City
DIRECTORY_TITLE=Parish Directory
