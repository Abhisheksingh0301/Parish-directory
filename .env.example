# ---------------------------------------------------------------
# Parish Directory — per-church configuration
# Copy this file to `.env` and edit. One copy of this app per church.
# ---------------------------------------------------------------

# Port the server listens on.
PORT=3000

# Where the SQLite database and uploaded photos are kept.
# Everything a parish owns lives in this one folder — back it up.
DATA_DIR=./data

# Secret used to sign session cookies. REQUIRED in production.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Set to "production" when deploying.
NODE_ENV=development

# Set to 1 when running behind a reverse proxy (nginx, Caddy, a PaaS)
# that terminates HTTPS, so secure cookies work correctly.
TRUST_PROXY=0

# Set to 1 to force `Secure` on the session cookie (HTTPS only).
# Leave unset to enable it automatically when NODE_ENV=production.
SECURE_COOKIES=

# How many minutes a signed-in session survives with nothing happening on it.
# Measured from the last thing the person actually did, not from when they
# signed in — so somebody working steadily is never interrupted, and a machine
# left unattended in the parish office signs itself out.
#
# 30 is the default. A shared desk in a busy office might want 10; a single
# private machine might want 120. Anything that is not a number, or is wildly
# out of range, falls back to 30 with a warning printed on startup.
SESSION_IDLE_MINUTES=30

# How long before that the browser offers "Your session is about to expire.
# Continue working?". Capped at half the idle window, so a short timeout does
# not warn before the countdown has meaningfully begun.
SESSION_WARNING_SECONDS=60

# --- Failed sign-ins --------------------------------------------------------

# No account is ever locked, whatever these are set to.
#
# A parish administrator's username is printed on nothing and guessable by
# anybody, and an account that locked on a few wrong guesses would hand any
# passer-by the power to shut the office out of its own directory at the moment
# it needs it. So a wrong password is answered by a wait that grows — patience
# a person spends once and a script cannot afford across thousands of guesses —
# and the hard stop is applied to the address doing the guessing instead.
#
# The wait starts after this many consecutive failures against one username or
# Family ID, so the ordinary two-fingered typo costs nothing.
LOGIN_DELAY_AFTER=2

# The first wait, in seconds, doubling with each further failure. It resets the
# moment that account signs in successfully.
LOGIN_DELAY_STEP_SECONDS=1

# The ceiling on that wait. A delayed request is a connection held open, so
# this is a real limit rather than a courtesy — do not raise it far.
LOGIN_DELAY_MAX_SECONDS=30

# Consecutive failures against one account before a line is written to the
# parish audit log. The wait itself is silent, so without this a parish would
# never learn which of its accounts somebody had been working on.
LOGIN_NOTICE_AFTER=5

# Failed sign-ins from ONE address, within the window below, before that
# address is refused outright. This is what catches a script working through a
# list of usernames — no single account goes near its own limit, but the
# address plainly is one.
#
# NOTE: this rule needs TRUST_PROXY=1 when the app sits behind nginx or another
# proxy. Without it every visitor appears to arrive from 127.0.0.1, so the rule
# stands down rather than block the whole parish at once — safe, but it means
# the rule is doing nothing. The Security page says so when that is the case.
LOGIN_IP_MAX_FAILURES=15
LOGIN_IP_WINDOW_MINUTES=60

# How long such an address stays refused. A super administrator can lift one
# early from System -> Security.
LOGIN_IP_BLOCK_MINUTES=60

# How long the sign-in log is kept. It records who was asked for, from where,
# on what kind of browser and whether it worked — never a password or a PIN.
#
# The audit log (exports, borrowed churches, hierarchy changes, verification
# reviews, deleted families, sign-in security events) is kept for the same
# number of days. Older lines are deleted for good.
LOGIN_LOG_RETENTION_DAYS=90

# Serving this install under a sub-path of a domain it shares with another
# site — https://example.com/parishdir/ rather than https://example.com/ —
# where the proxy strips the prefix before forwarding. In nginx:
#
#   location /parishdir/ {
#       proxy_pass http://127.0.0.1:3001/;   # the trailing slash strips it
#       proxy_redirect / /parishdir/;
#       ...
#   }
#
# Leave this EMPTY when the app has a domain or subdomain of its own — which
# is the ordinary case, and the one to prefer where you have the choice.
BASE_PATH=

# The password every family login is created with. One shared value on
# purpose: the parish sends it to everybody in a single email, along with
# the comma-separated address list from the families page. Anyone still on
# it is reminded to choose their own. Changing it here affects only logins
# created afterwards.
DEFAULT_USER_PASSWORD=Churchmembers@2026

# Seed values used only the first time the database is created.
# After that, edit them in the app under Settings.
PARISH_NAME=Malankara Mar Thoma Syrian Church
DIRECTORY_TITLE=Family Parish Directory

# --- Many churches in one installation -------------------------------------

# The diocese an already-running single-parish install is folded into when it
# is upgraded. Rename it in the console afterwards.
DIOCESE_NAME=Unnamed Diocese

# The database. Every query goes through Sequelize, so moving off SQLite is a
# configuration change rather than a code change — but see the note at the top
# of db/migrations.js about the schema history first.
# DATABASE_URL=postgres://user:pass@localhost:5432/parish
# DB_DIALECT=sqlite

# Log every SQL statement. Useful once, noisy always.
# LOG_SQL=1

