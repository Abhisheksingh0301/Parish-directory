<!DOCTYPE html>
<html lang="en">
<head>
<%- include('head-assets') %>
<title><%= title %> · <%= settings.parish_name %></title>
<link rel="stylesheet" href="/stylesheets/app.css">
</head>
<body class="app">

<header class="topbar">
  <div class="topbar-inner">
    <a class="brand" href="/">
      <%= settings.directory_title %>
      <small><%= settings.parish_name %></small>
    </a>

    <nav class="nav">
      <a href="/"          class="<%= path === '/' ? 'active' : '' %>">Dashboard</a>
      <a href="/families"  class="<%= path.startsWith('/families') ? 'active' : '' %>">Families</a>
      <a href="/directory" class="<%= path.startsWith('/directory') ? 'active' : '' %>">Print directory</a>
      <% if (atLeast('admin')) { %>
        <a href="/admin/settings" class="<%= path === '/admin/settings' ? 'active' : '' %>">Settings</a>
        <a href="/admin/users"    class="<%= path.startsWith('/admin/users') ? 'active' : '' %>">Users</a>
      <% } %>
    </nav>

    <div class="whoami">
      <a href="/account"><strong><%= currentUser.full_name || currentUser.username %></strong></a>
      <form method="post" action="/logout">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button type="submit" class="btn ghost small">Sign out</button>
      </form>
    </div>
  </div>
</header>

<main class="shell">
