<!DOCTYPE html>
<html lang="en">
<head>
<%- include('head-assets') %>
<title><%= title %> · <%= settings.parish_name %></title>
<link rel="stylesheet" href="/stylesheets/app.css">
</head>
<body class="app">

<header class="topbar">
  <div class="topbar-inner">
    <a class="brand" href="<%= isSuperAdmin && !churchId ? '/super' : '/' %>">
      <%= settings.directory_title %>
      <small><%= church ? church.name : settings.parish_name %></small>
    </a>

    <nav class="nav">
      <% if (isFamilyLogin) { %>
        <a href="/families/<%= currentUser.family_id %>"
           class="<%= path.startsWith('/families') ? 'active' : '' %>">Our entry</a>
      <% } else { %>
        <% if (churchId) { %>
          <a href="/"          class="<%= path === '/' ? 'active' : '' %>">Dashboard</a>
          <a href="/families"  class="<%= path.startsWith('/families') ? 'active' : '' %>">Families</a>
          <a href="/directory" class="<%= path.startsWith('/directory') ? 'active' : '' %>">Print directory</a>
          <% if (atLeast('admin')) { %>
            <a href="/admin/settings" class="<%= path === '/admin/settings' ? 'active' : '' %>">Settings</a>
            <a href="/admin/users"    class="<%= path.startsWith('/admin/users') ? 'active' : '' %>">Users</a>
          <% } %>
        <% } %>

        <% if (isSuperAdmin) { %>
          <a href="/super"           class="<%= path === '/super' ? 'active' : '' %>">System</a>
          <a href="/super/churches"  class="<%= path.startsWith('/super/churches') ? 'active' : '' %>">Churches</a>
          <a href="/super/reports"   class="<%= path.startsWith('/super/reports') ? 'active' : '' %>">Reports</a>
          <a href="/super/zones"     class="<%= path.startsWith('/super/zones') ? 'active' : '' %>"><%= labels.zone %>s</a>
          <a href="/super/dioceses"  class="<%= path.startsWith('/super/dioceses') ? 'active' : '' %>"><%= labels.diocese %>s</a>
        <% } %>
      <% } %>
    </nav>

    <div class="whoami">
      <a href="/account"><strong><%= currentUser.full_name || currentUser.username %></strong></a>
      <form method="post" action="/logout">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button type="submit" class="btn ghost small">Sign out</button>
      </form>
    </div>
  </div>
</header>

<%
  /*
   * A super administrator working inside a borrowed church is one click away
   * from editing the wrong parish's data. That is not a breach — they are
   * allowed everywhere — but it corrupts real records quietly, so the bar says
   * whose directory this is on every page until they leave it.
   */
%>
<% if (actingAs && church) { %>
  <div class="default-password-banner">
    <div class="inner">
      <span>
        You are working in <strong><%= church.name %></strong><%
        %><% if (church.city) { %>, <%= church.city %><% } %>.
        Anything you change here belongs to that parish.
      </span>
      <form method="post" action="/super/stop-acting" style="display:inline">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button type="submit" class="btn ghost small">Leave this church</button>
      </form>
    </div>
  </div>
<% } %>

<% if (currentUser.on_default_password) { %>
  <div class="default-password-banner" id="default-password-banner" hidden>
    <div class="inner">
      <span>
        You are still signed in with the password everyone was given.
        <a href="/account">Choose a password of your own</a>.
      </span>
      <button type="button" class="btn ghost small" data-dismiss-banner>Not now</button>
    </div>
  </div>
<% } %>

<main class="shell">
