<!DOCTYPE html>
<html lang="en">
<head>
<%- include('head-assets') %>
<title><%= title %> · <%= settings.parish_name %></title>
<link rel="stylesheet" href="<%= base %>/stylesheets/app.css">
</head>
<body class="app">

<header class="topbar">
  <div class="topbar-inner">
    <a class="brand" href="<%= base + (isSuperAdmin && !churchId ? '/super' : '/') %>">
      <%= settings.directory_title %>
      <small><%= church ? church.name : settings.parish_name %></small>
    </a>

<%
  /*
   * The navigation, in two tiers.
   *
   * Everything used to sit flat in one row, which held while there were four
   * links and stopped holding at nine: the row wrapped, and the name and Sign
   * out — the two things that must always be findable — were pushed onto a
   * second line below the fold of the bar.
   *
   * So the administration screens fold into one "Manage" menu. They are the
   * settings-and-housekeeping tier, visited occasionally; Dashboard, Families,
   * Review and Print directory are the daily work and stay in the open.
   *
   * The system screens do the same, but only for a super administrator who is
   * *acting inside a church*. When they are in their own console those three
   * are their whole application and hiding them would be perverse; once they
   * have borrowed a parish they are the secondary tier and the parish's own
   * navigation is primary.
   *
   * Each menu is a <details>, so it opens and closes with no JavaScript at
   * all. nav-menu.js only adds the courtesies — Escape, clicking away, and not
   * leaving two menus open at once.
   */
%>
    <nav class="nav">
      <% if (isFamilyLogin) { %>
        <a href="<%= base %>/families/<%= currentUser.family_id %>"
           class="<%= path.startsWith('/families') ? 'active' : '' %>">Our entry</a>
      <% } else { %>
        <% if (churchId) { %>
          <a href="<%= base %>/"          class="<%= path === '/' ? 'active' : '' %>">Dashboard</a>
          <a href="<%= base %>/families"  class="<%= path.startsWith('/families') ? 'active' : '' %>">Families</a>
          <% if (atLeast('editor')) { %>
            <a href="<%= base %>/review" class="<%= path.startsWith('/review') ? 'active' : '' %>">
              Review<% if (typeof pendingCount !== 'undefined' && pendingCount) { %>
                <span class="badge"><%= pendingCount %></span>
              <% } %>
            </a>
          <% } %>
          <a href="<%= base %>/directory" class="<%= path.startsWith('/directory') ? 'active' : '' %>">Print directory</a>
          <% if (atLeast('admin')) { %>
            <details class="nav-menu">
              <summary class="<%= path.startsWith('/admin') ? 'active' : '' %>">Manage</summary>
              <div class="nav-menu-items">
                <a href="<%= base %>/admin/settings" class="<%= path === '/admin/settings' ? 'active' : '' %>">Settings</a>
                <a href="<%= base %>/admin/users"    class="<%= path.startsWith('/admin/users') ? 'active' : '' %>">Users</a>
                <a href="<%= base %>/admin/import"   class="<%= path.startsWith('/admin/import') ? 'active' : '' %>">Import members</a>
                <a href="<%= base %>/admin/export"   class="<%= path.startsWith('/admin/export') ? 'active' : '' %>">Download your data</a>
                <a href="<%= base %>/admin/audit"    class="<%= path === '/admin/audit' ? 'active' : '' %>">Audit log</a>
              </div>
            </details>
          <% } %>
        <% } %>

        <% if (isSuperAdmin && !churchId) { %>
          <a href="<%= base %>/super"           class="<%= path === '/super' ? 'active' : '' %>">System</a>
          <a href="<%= base %>/super/churches"  class="<%= path.startsWith('/super/churches') ? 'active' : '' %>">Churches</a>
          <a href="<%= base %>/super/reports"   class="<%= path.startsWith('/super/reports') ? 'active' : '' %>">Reports</a>
        <% } else if (isSuperAdmin) { %>
          <details class="nav-menu">
            <summary class="<%= path.startsWith('/super') ? 'active' : '' %>">System</summary>
            <div class="nav-menu-items">
              <a href="<%= base %>/super"          class="<%= path === '/super' ? 'active' : '' %>">Console</a>
              <a href="<%= base %>/super/churches" class="<%= path.startsWith('/super/churches') ? 'active' : '' %>">Churches</a>
              <a href="<%= base %>/super/reports"  class="<%= path.startsWith('/super/reports') ? 'active' : '' %>">Reports</a>
            </div>
          </details>
        <% } %>
      <% } %>
    </nav>

    <div class="whoami">
      <a href="<%= base %>/account"><strong><%= currentUser.full_name || currentUser.username %></strong></a>
      <form method="post" action="<%= base %>/logout">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button type="submit" class="btn ghost small">Sign out</button>
      </form>
    </div>
  </div>
</header>

<%
  /*
   * A super administrator working inside a borrowed church is one click away
   * from editing the wrong parish's data. That is not a breach — they are
   * allowed everywhere — but it corrupts real records quietly, so the bar says
   * whose directory this is on every page until they leave it.
   */
%>
<% if (actingAs && church) { %>
  <div class="default-password-banner">
    <div class="inner">
      <span>
        You are working in <strong><%= church.name %></strong><%
        %><% if (church.city) { %>, <%= church.city %><% } %>.
        Anything you change here belongs to that parish.
      </span>
      <form method="post" action="<%= base %>/super/stop-acting" style="display:inline">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button type="submit" class="btn ghost small">Leave this church</button>
      </form>
    </div>
  </div>
<% } %>

<% if (currentUser.on_default_password) { %>
  <div class="default-password-banner" id="default-password-banner" hidden>
    <div class="inner">
      <span>
        You are still signed in with the password everyone was given.
        <a href="<%= base %>/account">Choose a password of your own</a>.
      </span>
      <button type="button" class="btn ghost small" data-dismiss-banner>Not now</button>
    </div>
  </div>
<% } %>

<main class="shell">
