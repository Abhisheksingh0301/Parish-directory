<%- include('../partials/header') %>

<%
  const colorLabels = {
    color_band:       'Name & ID band',
    color_band_dark:  'Members table header',
    color_member_a:   'Member row, odd',
    color_member_b:   'Member row, even',
    color_rule:       'Table borders'
  };
%>

<div class="page-head">
  <h1>Parish settings</h1>
  <p class="sub">
    Everything that makes this copy of the directory belong to your church.
    No code changes are needed to set up a new parish.
  </p>
</div>

<%- include('../partials/messages') %>

<form method="post" action="<%= base %>/admin/settings">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">

  <div class="card">
    <h2>Identity</h2>

    <div class="field">
      <label for="parish_name">Parish name</label>
      <input type="text" id="parish_name" name="parish_name" value="<%= values.parish_name %>" required>
      <p class="help">Printed at the foot of every directory page.</p>
    </div>

    <div class="field">
      <label for="directory_title">Directory title</label>
      <input type="text" id="directory_title" name="directory_title" value="<%= values.directory_title %>">
      <p class="help">Shown in the app header and the browser tab, e.g. &ldquo;Home Parish Directory 2026&rdquo;.</p>
    </div>

    <div class="field">
      <label for="default_member_password">Password for new member logins</label>
      <input type="text" id="default_member_password" name="default_member_password"
             value="<%= values.default_member_password %>" required minlength="8">
      <p class="help">
        The one password every household in <em>this church</em> is given when
        its login is created, so the office can put it in a single email. It is
        yours alone &mdash; no other church can see it, and each family is asked
        to change it once they are in.
      </p>
    </div>
  </div>

  <%
    /*
     * Which changes need whose approval.
     *
     * The recommendation for a pilot is one queue for everything: it is the
     * simplest thing to operate, and with five or ten families the volume is
     * small enough that there is no risk of a field being mis-classified. Once
     * the parish has seen what a real batch of corrections looks like, the
     * two-tier split can be switched on for the full rollout — the review
     * screen is the same either way.
     */
    const routine = new Set(
      String(values.routine_fields || '')
        .split(',').map(function (s) { return s.trim().toLowerCase(); }).filter(Boolean)
    );
    const twoTier = String(values.approval_tiers || '1') === '2';
  %>

  <div class="card">
    <h2>Which changes require approval</h2>

    <div class="field">
      <div class="label">Approval queues</div>

      <label class="checkline" style="text-transform:none;font-weight:500;letter-spacing:0">
        <input type="radio" name="approval_tiers" value="1" <%= twoTier ? '' : 'checked' %>>
        <span>
          <strong>One queue for everything.</strong>
          Every change is approved on its own line, by Achen or an
          administrator. Recommended for the pilot.
        </span>
      </label>

      <label class="checkline" style="text-transform:none;font-weight:500;letter-spacing:0;margin-top:10px">
        <input type="radio" name="approval_tiers" value="2" <%= twoTier ? 'checked' : '' %>>
        <span>
          <strong>Two tiers.</strong>
          Routine changes may be cleared by an editor, and offered as a single
          batch; everything else is approved individually by an administrator.
        </span>
      </label>
    </div>

    <div class="field">
      <div class="label">Routine fields <span class="hint">— light-touch review</span></div>
      <p class="help" style="margin-top:0">
        Ticked fields are routine when two tiers are switched on. Everything
        unticked is significant. Moving a field from one tier to the other is
        this list and nothing else — no code changes.
      </p>

      <div class="tier-grid">
        <% tierableFields.forEach(function (field) { %>
          <label class="checkline">
            <input type="checkbox" name="routine_fields" value="<%= field.key %>"
                   <%= routine.has(field.key) ? 'checked' : '' %>>
            <span><%= field.label %> <span class="hint">— <%= field.scope %></span></span>
          </label>
        <% }); %>
      </div>
    </div>

    <p class="help">
      <strong>Never editable by a family:</strong>
      the Family ID, and inclusion in the printed directory. These are not
      proposals a family can make at all — they remain with the parish office,
      and a submission carrying them is ignored.
    </p>
  </div>

  <div class="card">
    <h2>Printed layout</h2>

    <div class="grid-2">
      <div class="field">
        <label for="per_page">Families per printed page</label>
        <input type="number" id="per_page" name="per_page" min="1" max="6" value="<%= values.per_page %>">
        <p class="help">
          <strong>One</strong> gives each family a sheet of its own: a large
          photograph across the top with the details and members beneath it.
          That is the default, and it is what most parishes print.
          <strong>Two or more</strong> switches to the compact entry, with a
          smaller photograph beside the details instead of above them, so that
          several fit on one sheet.
        </p>
      </div>

      <div class="field">
        <label for="starting_page">Starting page number</label>
        <input type="number" id="starting_page" name="starting_page" min="0" value="<%= values.starting_page %>">
        <p class="help">Set this if the directory follows front matter in the printed book.</p>
      </div>
    </div>

    <div class="field">
      <label for="relation_options">Relations</label>
      <input type="text" id="relation_options" name="relation_options" value="<%= values.relation_options %>">
      <p class="help">
        Comma separated — Head, Spouse, Son, Daughter and so on. Offered as
        suggestions in the member editor and printed as typed, so use whole
        words rather than codes unless your parish already prints codes.
      </p>
    </div>
  </div>

  <div class="card">
    <h2>Printed colours</h2>
    <p class="help" style="margin:-8px 0 16px">
      The palette of the printed entry. Defaults match the approved template.
    </p>

    <div class="grid-2">
      <% colorKeys.forEach(function (key) { %>
        <div class="field">
          <label for="<%= key %>"><%= colorLabels[key] %></label>
          <input type="color" id="<%= key %>" name="<%= key %>" value="<%= values[key] %>">
          <p class="help"><%= values[key] %></p>
        </div>
      <% }); %>
    </div>
  </div>

  <div class="actions">
    <button type="submit" class="btn">Save settings</button>
    <a href="<%= base %>/directory" class="btn ghost">Preview the directory</a>
  </div>
</form>

<form method="post" action="<%= base %>/admin/settings/reset-colors" class="card" style="margin-top:24px">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <h2>Reset colours</h2>
  <p class="help" style="margin:-8px 0 14px">Put the five printed colours back to the template defaults.</p>
  <button type="submit" class="btn ghost">Reset to template colours</button>
</form>

<%- include('../partials/footer') %>
