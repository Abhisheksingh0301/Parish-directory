<%- include('../partials/header') %>

<div class="page-head">
  <h1>Import members from a spreadsheet</h1>
  <p class="sub">
    The parish already has its families written down somewhere: a register, a
    ledger, or somebody&rsquo;s spreadsheet. Nobody should have to type it in
    twice. Download the sheet below, fill it in, and upload it here.
  </p>
</div>

<%
  /*
   * The outcome of an upload, at the top of the page rather than beside the
   * button, because it is the only thing the person is looking for when the
   * page comes back and it is longer than the button is.
   *
   * Either `problems` or `result` is filled in, never both: a sheet with a
   * single problem in it imports nothing at all.
   */
%>
<% if (problems.length) { %>
  <div class="alert error">
    <strong>
      Nothing was imported<%= fileName ? ` from ${fileName}` : '' %>.
      <% if (problemCount > 1) { %>
        There are <%= problemCount %> things to fix first.
      <% } %>
    </strong>
    <ul>
      <% problems.forEach(function (problem) { %>
        <li>
          <% if (problem.line) { %><strong>Row <%= problem.line %>:</strong> <% } %>
          <%= problem.message %>
        </li>
      <% }); %>
      <% if (problemsHidden) { %>
        <li>&hellip;and <%= problemsHidden %> more. Fix these first &mdash; the
          same mistake usually explains the rest.</li>
      <% } %>
    </ul>
    <p style="margin:10px 0 0">
      Correct those rows in your spreadsheet, save it again as
      <code>.csv</code>, and upload it once more. Nothing in the directory has
      changed, so there is nothing to undo.
    </p>
  </div>
<% } %>

<% if (result) { %>
  <div class="alert notice">
<%
      /* "Imported 12 families and 41 people", "Updated 380 families already in
         the directory", or both halves joined — built here rather than spelled
         out in four nested conditions in the markup. */
      const done = [];
      if (result.families) {
        done.push(`imported ${result.families} famil${result.families === 1 ? 'y' : 'ies'}` +
          (result.people ? ` and ${result.people} ${result.people === 1 ? 'person' : 'people'}` : ''));
      }
      if (result.updated) {
        done.push(`updated ${result.updated} famil${result.updated === 1 ? 'y' : 'ies'} ` +
          'already in the directory');
      }
      const sentence = done.join(', and ');
    %>
    <strong>
      <%= sentence.charAt(0).toUpperCase() + sentence.slice(1) %><%
        %><%= fileName ? ` from ${fileName}` : '' %>.
    </strong>

    <% if (result.families) { %>
      <p style="margin:8px 0 0">
        The new families arrived as <strong>drafts</strong>, so none of them
        are in the printed book yet. Look them over in
        <a href="<%= base %>/families">Families</a> and publish the ones that
        are right. <strong>No logins were created</strong> &mdash; accounts
        are a separate, deliberate step on
        <a href="<%= base %>/admin/users">User accounts</a>.
      </p>
    <% } %>

    <% if (result.updated) { %>
      <p style="margin:8px 0 0">
        The families that were already here kept their photographs, their
        place in the printed book, and their place on the verification chain.
        Only the cells your sheet filled in were written.
        <% if (result.membersReplaced) { %>
          <%= result.membersReplaced %> of them had
          <%= result.membersReplaced === 1 ? 'its' : 'their' %> member list
          rebuilt from the sheet.
        <% } else { %>
          Your sheet carried no member rows for them, so their households were
          left as they were.
        <% } %>
      </p>
    <% } %>

    <% if (result.adjusted.length) { %>
      <p style="margin:10px 0 4px">Decisions made for you, so you can check them:</p>
      <ul>
        <% result.adjusted.forEach(function (item) { %>
          <li><%= item.message %></li>
        <% }); %>
      </ul>
    <% } %>

    <% if (result.unexpected.length) { %>
      <p style="margin:10px 0 4px">
        These looked fine a moment earlier and then did not &mdash; somebody
        else was probably working on the directory at the same time. Nothing
        was overwritten:
      </p>
      <ul>
        <% result.unexpected.forEach(function (item) { %>
          <li><%= item.message %></li>
        <% }); %>
      </ul>
    <% } %>
  </div>
<% } %>

<% if (unknownColumns.length) { %>
  <div class="alert error" style="background:var(--paper-warm);border-color:var(--rule);color:var(--ink)">
    <strong>Columns this directory has no home for</strong>
    <p style="margin:6px 0 0">
      <% unknownColumns.forEach(function (name, i) { %><code><%= name %></code><%= i < unknownColumns.length - 1 ? ', ' : '' %><% }); %>
      <%= unknownColumns.length === 1 ? 'was' : 'were' %> not recognised as
      <%= unknownColumns.length === 1 ? 'a heading' : 'headings' %> this
      directory stores, so whatever is in
      <%= unknownColumns.length === 1 ? 'it' : 'them' %>
      <%= result ? 'has not been kept' : 'would not be kept' %>. This is
      reported rather than silently ignored, but it does not stop the import
      on its own. If one of these is a column this directory does hold, under
      another name, the table below says what to call it.
    </p>
  </div>
<% } %>

<div class="card">
  <h2>Get the template</h2>
  <p class="help" style="margin-top:0">
    A comma-separated file. Excel, LibreOffice and Google Sheets all open it
    just by double-clicking. Fill it in there and save it back as
    <code>.csv</code>. If you save it as <code>.xlsx</code> instead, this app
    cannot read it.
  </p>

  <div class="actions">
    <a class="btn" href="<%= base %>/admin/import-template.csv">Template with example rows</a>
    <a class="btn ghost" href="<%= base %>/admin/import-template.csv?examples=0">
      Headings only
    </a>
  </div>

  <p class="help">
    The example rows are there to be read and then deleted. The headings-only
    file is the same sheet with nothing under them.
  </p>
</div>

<form class="card" method="post" action="<%= base %>/admin/import"
      enctype="multipart/form-data">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">

  <h2>Upload the filled-in sheet</h2>
  <p class="help" style="margin-top:0">
    The whole file is read and checked before anything is written. If there is
    a problem anywhere in it &mdash; a date nobody could read, an email address
    that is not one, a mobile number too short to ring, a family with no name,
    or a Family ID this parish already has &mdash; it is listed at the top of
    this page in plain words, with the row number, and
    <strong>nothing at all is imported</strong>. Fix the sheet and upload it
    again. There is no half-finished state to clean up.
  </p>

  <div class="field">
    <label for="sheet">Your spreadsheet, saved as CSV</label>
    <input type="file" id="sheet" name="sheet" accept=".csv,text/csv" required>
    <p class="help">
      A <code>.csv</code> file, up to <%= maxSheetMb %>&nbsp;MB. An Excel
      <code>.xlsx</code> workbook cannot be read &mdash; open it, choose
      File&nbsp;&rarr;&nbsp;Save&nbsp;As and pick
      &ldquo;CSV (comma delimited)&rdquo;.
    </p>
  </div>

  <%
    /*
     * The second sheet a parish uploads is usually the first one with the
     * addresses put right, and every Family ID on it is already here. Left to
     * itself the import skips all of them and the office is told, correctly
     * and uselessly, that its whole parish is already in the directory.
     *
     * So the office says which of the two it means, and the safe reading is
     * the one that is already chosen: a Family ID the directory holds stops
     * the import unless somebody has deliberately said otherwise.
     */
  %>
  <fieldset class="field choice">
    <legend>A Family ID this directory already holds</legend>

    <label class="choice-row">
      <input type="radio" name="on_existing" value="skip"
             <%= onExisting === 'update' ? '' : 'checked' %>>
      <span>
        <strong>Stop, and tell me which rows</strong>
        <span class="help">
          Nothing is written. Use this for families the directory does not
          have yet.
        </span>
      </span>
    </label>

    <label class="choice-row">
      <input type="radio" name="on_existing" value="update"
             <%= onExisting === 'update' ? 'checked' : '' %>>
      <span>
        <strong>Update that family from the sheet</strong>
        <span class="help">
          Use this when you re-upload a corrected sheet. Filled-in cells
          overwrite the old value; <strong>blank cells change nothing</strong>.
          If the sheet lists members for a family, they
          <strong>replace that family&rsquo;s member list</strong>.
          Photographs, printed-book inclusion and verification status are left
          as they are.
        </span>
      </span>
    </label>

    <p class="help">
      Replacing a family&rsquo;s members drops any correction it has waiting
      in the <a href="<%= base %>/review">review queue</a>. Nothing breaks,
      but that correction will not arrive. Clear the queue first if it holds
      anything you need.
    </p>
  </fieldset>

  <div class="actions">
    <button type="submit" class="btn">Check and import</button>
  </div>
</form>

<div class="card">
  <h2>The one rule that matters</h2>
  <p class="help" style="margin-top:0">
    <strong>One row per person, not one row per family.</strong> A family of
    five is five rows, all carrying the same <strong>Family ID</strong>. That
    column is what ties them together, and it is the only column the import
    refuses to work without.
  </p>
  <p class="help">
    The family&rsquo;s own details &mdash; address, prayer group, date of
    marriage &mdash; are read from the <em>first</em> row carrying that Family
    ID. You can leave them blank on the rest of the household&rsquo;s rows, or
    repeat them. Either way is fine.
  </p>
  <p class="help">
    Two families must never share a Family ID. If this parish already has a
    Family ID from the sheet, the import stops and reports the row number,
    unless you asked for that family to be updated from the sheet instead.
    This way, a record the office corrected by hand is never overwritten by an
    accidental second import, but a corrected sheet can still be re-uploaded
    on purpose.
  </p>
</div>

<div class="card">
  <h2>The columns</h2>
  <p class="help" style="margin-top:0">
    Column order does not matter. Letter case, spacing and punctuation in the
    headings do not matter either &mdash; &ldquo;Family ID&rdquo;,
    &ldquo;family_id&rdquo; and &ldquo;FAMILY&nbsp;&nbsp;ID.&rdquo; are all read
    as the same column. If the parish sheet already calls a column something
    else, check the alternatives here before renaming anything: it is
    probably already recognised as it stands. A column that matches no known
    heading is reported when the sheet is read, never dropped silently.
  </p>

  <table class="table">
    <thead>
      <tr>
        <th>Heading in the template</th>
        <th>Also accepted as</th>
      </tr>
    </thead>
    <tbody>
      <% fields.forEach((field) => { %>
        <tr>
          <td>
            <strong><%= columnLabels[field] %></strong>
            <% if (required.includes(field)) { %>
              <span class="tag">Required</span>
            <% } %>
          </td>
          <td class="help">
            <%= aliases[field].filter((a) => a !== columnLabels[field].toLowerCase()).join(', ') %>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>

<div class="card">
  <h2>Filling in the awkward columns</h2>

  <p class="help" style="margin-top:0">
    <strong>Relation.</strong> Use this parish&rsquo;s own codes, the same
    ones the member editor offers:
    <% if (relations.length) { %>
      <% relations.forEach((relation, i) => { %><code><%= relation %></code><%= i < relations.length - 1 ? ', ' : '' %><% }) %>.
    <% } else { %>
      none are set yet &mdash; add them on the
      <a href="<%= base %>/admin/settings">Settings</a> page first.
    <% } %>
    Change them on Settings, and the template you download changes with them.
  </p>

  <p class="help">
    <strong>Dates.</strong> Write them however the register has them.
    <code>02-Aug-1975</code>, <code>2/8/1975</code>, <code>1975-08-02</code>
    and <code>Aug 1975</code> are all read correctly. Where two numbers could
    mean either order, the <em>day comes first</em> &mdash; so
    <code>03/04/1978</code> means the third of April. A date that cannot be
    read at all is reported and the row is rejected, not silently left blank.
  </p>

  <p class="help">
    <strong>Years are dropped.</strong> This directory prints only the day and
    month for both dates, and stores no year for either. It says when to wish
    somebody, not how old they are. You can still write the year if the
    register has it &mdash; it is read and then dropped, not refused, so you
    do not need to strip it out of the sheet first.
  </p>

  <p class="help">
    <strong>Date of marriage</strong> belongs to the member, not the family, so
    it goes on the row of each person who was married: both partners, and both
    again for a married son or daughter living in the same household.
  </p>

  <p class="help">
    <strong>Email addresses.</strong> There are two columns, and they are not
    the same thing. <code>Email</code> is the family&rsquo;s own address, and
    it doubles as the household&rsquo;s sign-in name &mdash; a typo here means
    that family cannot sign in to verify its own entry. <code>Emails</code> is
    the member&rsquo;s own, and one member may list up to three, separated by
    commas.
  </p>

  <p class="help">
    Both are checked properly, not loosely. <code>steve@gmail</code> is
    refused, because a bare hostname like that is a real address only on an
    office network, not on the internet. Anything that is not an email address
    at all &mdash; a name, a phone number, a note &mdash; stops the whole file,
    with the row number reported.
  </p>

  <p class="help">
    <strong>Mobile numbers.</strong> Ten digits, beginning with 6, 7, 8 or 9. A
    leading <code>0</code> is removed rather than refused, spaces and dashes
    are ignored, and a member may list up to three numbers separated by
    commas.
  </p>

  <p class="help">
    <strong>Head of family.</strong> If this is left blank, the first member
    listed for that family is taken as the head, and the import tells you so.
    A family with no head and no members is refused, since a printed entry
    must have a title.
  </p>

  <p class="help">
    <strong>Address.</strong> A line break inside the cell is fine. The
    two-line address you get from pressing Alt+Enter in Excel comes through
    intact.
  </p>

  <p class="help">
    <strong>Photographs</strong> are not part of this sheet. Import the
    families first, then send the pictures as their own folder on
    <a href="<%= base %>/admin/photos">Import photographs</a>, with each file
    named after the Family ID it belongs to. A single late photograph can
    still be added from the family&rsquo;s own page.
  </p>
</div>

<div class="card">
  <h2>What the import will and will not do</h2>
  <p class="help" style="margin-top:0">
    <strong>All of the sheet, or none of it.</strong> The file is read all the
    way through before a single family is written, and one problem anywhere
    stops the whole run. If it says the import succeeded, everything in the
    file was imported &mdash; you never end up with a half-loaded directory.
  </p>
  <p class="help">
    <strong>Nothing already here is touched unless you ask.</strong> A Family
    ID this parish already holds is reported as a problem to fix in the sheet.
    It is never merged and never overwritten, unless you chose to update
    those families above. So running the same import twice by accident can
    never undo a correction the office made by hand.
  </p>
  <p class="help">
    Everything that comes in arrives as a <strong>draft</strong>, so nothing
    enters the printed book until somebody has looked at it. And
    <strong>no logins are created</strong> &mdash; accounts are a separate,
    deliberate step on
    <a href="<%= base %>/admin/users">User accounts</a>.
  </p>

<%
  /*
   * The command line, for the person who has a shell.
   *
   * The form above is what a parish administrator uses and it is enough for
   * any sheet a parish actually has. This is still worth printing for a super
   * administrator, because it can do the one thing the form deliberately will
   * not: import what it can and write the rows it could not to a rejects file,
   * which is the tool for a sheet too broken to fix a row at a time.
   *
   * It is inside the isSuperAdmin guard because a parish administrator has no
   * shell — printing a command to them describes a job they cannot do and
   * reads as an instruction they have failed to follow.
   */
%>
<% if (isSuperAdmin) { %>
  <p class="help">
    The same import from a shell, which reports rather than refuses and can
    write out the rows it could not read:
  </p>
  <p class="help">
    <code>npm run import-families -- --church <%= church.slug %> --file parish.csv --dry-run</code>
  </p>
  <p class="help">
    Running it again without <code>--dry-run</code> loads the file. Adding
    <code>--rejects bad.csv</code> writes out exactly the rows that failed,
    with the reason in the last column, ready to be fixed and imported again.
  </p>
<% } %>
</div>

<%- include('../partials/footer') %>
