<%- include('partials/header') %>

<div class="page-head">
  <h1>Dashboard</h1>
  <div class="spacer"></div>
  <div class="actions" style="margin:0">
    <% if (canEdit) { %><a href="<%= base %>/families/new" class="btn">Add a family</a><% } %>
    <a href="<%= base %>/directory" class="btn ghost">Print directory</a>
  </div>
</div>

<div class="stats" style="margin-bottom:22px">
  <div class="stat"><div class="n"><%= stats.families %></div><div class="k">Families</div></div>
  <div class="stat"><div class="n"><%= stats.members %></div><div class="k">People</div></div>
  <div class="stat"><div class="n"><%= stats.published %></div><div class="k">In the printed book</div></div>
  <div class="stat">
    <div class="n"><%= stats.families - stats.published %></div>
    <div class="k">Drafts, not printed</div>
  </div>
</div>

<%
  /*
   * The verification chain, counted. Each tile clicks through to the list of
   * exactly those families, which is the point — a number nobody can open is
   * a number nobody trusts.
   */
  const filterQuery = [
    filter.area ? 'area=' + encodeURIComponent(filter.area) : '',
    filter.prayerGroup ? 'group=' + encodeURIComponent(filter.prayerGroup) : ''
  ].filter(Boolean).join('&');
%>

<div class="card">
  <h2>
    Verification status
    <span class="hint">
      — <%= statusTotal %> famil<%= statusTotal === 1 ? 'y' : 'ies' %><%
      %><% if (filter.area) { %> in <%= filter.area %><% } %><%
      %><% if (filter.prayerGroup) { %> in <%= filter.prayerGroup %><% } %>
    </span>
  </h2>

  <% if (groupings.areas.length || groupings.prayerGroups.length) { %>
    <form method="get" action="<%= base %>/" class="filter-bar">
      <% if (groupings.areas.length) { %>
        <label>
          Area
          <select name="area" onchange="this.form.submit()">
            <option value="">All areas</option>
            <% groupings.areas.forEach(function (a) { %>
              <option value="<%= a %>" <%= filter.area === a ? 'selected' : '' %>><%= a %></option>
            <% }); %>
          </select>
        </label>
      <% } %>
      <% if (groupings.prayerGroups.length) { %>
        <label>
          Prayer Group
          <select name="group" onchange="this.form.submit()">
            <option value="">All prayer groups</option>
            <% groupings.prayerGroups.forEach(function (g) { %>
              <option value="<%= g %>" <%= filter.prayerGroup === g ? 'selected' : '' %>><%= g %></option>
            <% }); %>
          </select>
        </label>
      <% } %>
      <noscript><button type="submit" class="btn ghost small">Apply</button></noscript>
    </form>
  <% } %>

  <div class="chain">
    <% statuses.forEach(function (step, i) { %>
      <a class="chain-step <%= statusCounts[step.key] ? '' : 'is-empty' %>"
         href="<%= base %>/families/status?status=<%= step.key %><%= filterQuery ? '&' + filterQuery : '' %>">
        <span class="n"><%= statusCounts[step.key] %></span>
        <span class="k"><%= step.label %></span>
      </a>
    <% }); %>
  </div>

  <div class="actions">
    <a href="<%= base %>/families/status<%= filterQuery ? '?' + filterQuery : '' %>" class="btn ghost">
      Every family and its status
    </a>
    <a href="<%= base %>/families/status/print<%= filterQuery ? '?' + filterQuery : '' %>" class="btn ghost">
      Printable follow-up sheet
    </a>
    <% if (waiting) { %>
      <a href="<%= base %>/review" class="btn">
        Review <%= waiting %> <%= waiting === 1 ? 'change' : 'changes' %> waiting
      </a>
    <% } %>
  </div>

  <p class="help">
    <strong>Invitation Sent</strong> records that the parish office sent the
    invitations. The application sends no email itself, so this is a record of
    the parish&rsquo;s action and not a delivery receipt from a mail server.
  </p>
</div>

<div class="grid-2">
  <div class="card">
    <h2>Coming up <span class="hint">— next 30 days</span></h2>

    <% if (!upcoming.length) { %>
      <p class="empty" style="padding:20px 0">
        No birthdays or anniversaries recorded in the next 30 days.
      </p>
    <% } else { %>
      <table class="table">
        <tbody>
          <% upcoming.forEach(function (item) { %>
            <tr>
              <td>
                <a href="<%= base %>/families/<%= item.fid %>"><%= item.name %></a>
                <% if (item.kind === 'anniversary') { %>
                  <span class="tag">Anniversary</span>
                <% } %>
              </td>
              <td class="nowrap"><%= item.label %></td>
              <td class="nowrap right" style="color:var(--ink-faint)">
                <%= item.inDays === 0 ? 'Today' : (item.inDays === 1 ? 'Tomorrow' : 'In ' + item.inDays + ' days') %>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
      <p class="help" style="margin-top:10px">
        Listed by day and month, so a birthday and an anniversary sit together.
      </p>
    <% } %>
  </div>

  <div class="card">
    <h2>Getting started</h2>
    <ol class="stack" style="margin:0;padding-left:20px;font-size:15px">
      <li>
        <a href="<%= base %>/admin/settings">Set the parish name</a> and choose how many
        families print on each page.
      </li>
      <li><a href="<%= base %>/families/new">Add families</a>, each with its members, photo and dates.</li>
      <li>
        Keep an entry as a <strong>draft</strong> while you are still collecting
        details — drafts stay out of the printed book.
      </li>
      <li>
        <a href="<%= base %>/directory">Open the print directory</a> and use your browser&rsquo;s
        print dialog to save it as a PDF or send it to a printer.
      </li>
      <% if (isAdmin) { %>
        <li><a href="<%= base %>/admin/users">Invite the parish office</a> to help, as editors or viewers.</li>
      <% } %>
    </ol>
  </div>
</div>

<%- include('partials/footer') %>
