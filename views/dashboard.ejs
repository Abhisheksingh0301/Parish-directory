<%- include('partials/header') %>

<%
  const greeting = (function () {
    const hour = new Date().getHours();
    if (hour < 12) return 'Good morning';
    if (hour < 17) return 'Good afternoon';
    return 'Good evening';
  })();
  const whoShort = String(currentUser.full_name || currentUser.username || '').split(/\s+/)[0];
%>

<div class="page-head">
  <div class="titleblock">
    <p class="eyebrow"><%= greeting %><%= whoShort ? ', ' + whoShort : '' %></p>
    <h1>Dashboard</h1>
  </div>
  <div class="spacer"></div>
  <div class="actions">
    <a href="<%= base %>/directory" class="btn ghost">Print directory</a>
    <% if (canEdit) { %><a href="<%= base %>/families/new" class="btn">Add a family</a><% } %>
  </div>
</div>

<%
  /*
   * The four figures, as one ledger rather than four cards.
   *
   * "In the printed book" is the accented column because it is the number the
   * parish is working towards; "Drafts, not printed" is muted because it is
   * what is left over, and the foot line under each says what the figure
   * counts so the caption never has to carry two jobs.
   */
  const drafts = stats.families - stats.published;
%>
<section class="stats">
  <div class="stat">
    <div class="n"><%= stats.families %></div>
    <div class="k">Families</div>
    <div class="foot">on the register</div>
  </div>
  <div class="stat">
    <div class="n"><%= stats.members %></div>
    <div class="k">People</div>
    <div class="foot">across all households</div>
  </div>
  <div class="stat accent">
    <div class="n"><%= stats.published %></div>
    <div class="k">In the printed book</div>
    <div class="foot">ready for the annual edition</div>
  </div>
  <div class="stat <%= drafts ? '' : 'muted' %>">
    <div class="n"><%= drafts %></div>
    <div class="k">Drafts, not printed</div>
    <div class="foot"><%= drafts ? 'still being collected' : 'nothing pending' %></div>
  </div>
</section>

<%
  /*
   * The verification chain, counted. Each step clicks through to the list of
   * exactly those families, which is the point — a number nobody can open is
   * a number nobody trusts.
   */
  const filterQuery = filter.prayerGroup
    ? 'group=' + encodeURIComponent(filter.prayerGroup)
    : '';
%>

<div class="cols">
  <section class="card">
    <div class="board-head">
      <div>
        <h2>Verification status</h2>
        <p class="sub">
          Where all <%= statusTotal %> famil<%= statusTotal === 1 ? 'y' : 'ies' %>
          stand in the review process<%
          %><% if (filter.prayerGroup) { %>, in <%= filter.prayerGroup %><% } %>
        </p>
      </div>

      <% if (groupings.prayerGroups.length) { %>
        <form method="get" action="<%= base %>/" class="filters">
          <% if (groupings.prayerGroups.length) { %>
            <label class="sr-only" for="dash-group">Prayer Group</label>
            <select id="dash-group" name="group" onchange="this.form.submit()">
              <option value="">All prayer groups</option>
              <% groupings.prayerGroups.forEach(function (g) { %>
                <option value="<%= g %>" <%= filter.prayerGroup === g ? 'selected' : '' %>><%= g %></option>
              <% }); %>
            </select>
          <% } %>
          <noscript><button type="submit" class="btn ghost small">Apply</button></noscript>
        </form>
      <% } %>
    </div>

    <div class="chain">
      <% statuses.forEach(function (step) { %>
        <a class="chain-step <%= statusCounts[step.key] ? '' : 'is-empty' %>"
           href="<%= base %>/families/status?status=<%= step.key %><%= filterQuery ? '&' + filterQuery : '' %>">
          <span class="n"><%= statusCounts[step.key] %></span>
          <span class="k"><%= step.label %></span>
        </a>
      <% }); %>
    </div>

    <p class="chain-note">
      <b>Invitation Sent</b> means the parish office has sent the invitations.
      The app does not send any email itself &mdash; this only records that the
      office did. It does not confirm the email reached anyone.
    </p>

    <div class="actions">
      <a href="<%= base %>/families/status<%= filterQuery ? '?' + filterQuery : '' %>" class="btn ghost">
        Every family and its status
      </a>
      <a href="<%= base %>/families/status/print<%= filterQuery ? '?' + filterQuery : '' %>" class="btn ghost">
        Printable follow-up sheet
      </a>
      <% if (waiting) { %>
        <a href="<%= base %>/review" class="btn">
          Review changes waiting <span class="badge"><%= waiting %></span>
        </a>
      <% } %>
    </div>
  </section>

  <div class="side">
    <%
      /*
       * The almanac. Each row is a date and an occasion, and the date is set
       * apart in its own gutter because that is the column the eye runs down
       * — the parish office is looking for "what falls this week", not for a
       * particular name.
       *
       * The month is drawn from the item's own day and month numbers rather
       * than from its label, so the gutter is always two short lines and never
       * inherits whatever width the long-form label happens to have.
       */
      const MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun',
                      'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
    %>
    <section class="card flush almanac">
      <div class="board-head">
        <div>
          <h2>Coming up</h2>
          <p class="sub">Anniversaries &amp; milestones</p>
        </div>
        <span class="count">Next 30 days</span>
      </div>

      <% if (!upcoming.length) { %>
        <p class="empty">No birthdays or anniversaries in the next 30 days.</p>
      <% } else { %>
        <div class="events">
          <% upcoming.forEach(function (item) { %>
            <div class="event">
              <div class="date">
                <div class="d"><%= item.day %></div>
                <div class="m"><%= MONTHS[item.month - 1] %></div>
              </div>
              <div class="divider"></div>
              <div class="body">
                <div class="nm">
                  <a href="<%= base %>/families/<%= item.fid %>"><%= item.name %></a>
                  <% if (item.kind === 'anniversary') { %>
                    <span class="anniv">anniversary</span>
                  <% } %>
                </div>
                <div class="when">
                  <%= item.inDays === 0 ? 'Today'
                      : item.inDays === 1 ? 'Tomorrow'
                      : 'In ' + item.inDays + ' days' %>
                </div>
              </div>
              <a class="go" href="<%= base %>/families/<%= item.fid %>"
                 aria-label="Open the <%= item.head_name %> family">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2" stroke-linecap="round"
                     aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg>
              </a>
            </div>
          <% }); %>
        </div>
      <% } %>
    </section>

    <%#
      Getting started. The numerals are drawn by a CSS counter rather than
      typed, so a step added or removed here cannot leave the list counting
      1, 2, 2, 4 — which is what an <ol> would have given us for free, but an
      <ol> cannot put the numeral in a circle of its own beside the text.
    %>
    <section class="card flush guide">
      <div class="board-head"><div><h2>Getting started</h2></div></div>
      <div class="steps">
        <div class="step">
          <div class="idx"></div>
          <div class="txt">
            <a href="<%= base %>/admin/settings">Set the parish name</a> and choose
            how many families print on each page.
          </div>
        </div>
        <div class="step">
          <div class="idx"></div>
          <div class="txt">
            <a href="<%= base %>/families/new">Add families</a>, each with its
            members, photograph and dates.
          </div>
        </div>
        <div class="step">
          <div class="idx"></div>
          <div class="txt">
            Keep an entry as a <strong>draft</strong> while you are still
            collecting details &mdash; drafts stay out of the printed book.
          </div>
        </div>
        <div class="step">
          <div class="idx"></div>
          <div class="txt">
            <a href="<%= base %>/directory">Open the print directory</a> and use
            your browser&rsquo;s print dialog to save a PDF or send it to a printer.
          </div>
        </div>
        <div class="step">
          <div class="idx"></div>
          <div class="txt">
            Look a family up by name or Prayer Group in the
            <a href="#family-index">Family index</a> below &mdash; it reads
            straight off the register, so it is always current.
          </div>
        </div>
        <% if (isAdmin) { %>
          <div class="step">
            <div class="idx"></div>
            <div class="txt">
              <a href="<%= base %>/admin/users">Invite the parish office</a> to
              help, as editors or viewers.
            </div>
          </div>
        <% } %>
      </div>
    </section>
  </div>
</div>

<section class="card flush family-index" id="family-index">
  <div class="board-head">
    <div>
      <h2>Family Index</h2>
      <p class="sub">Every family, by name or Prayer Group, with the printed page it falls on</p>
    </div>
    <span class="count" id="fiCount"></span>
  </div>

  <div class="fi-controls">
    <input type="search" id="fiQ" placeholder="Search head of family, Family ID or Prayer Group…" aria-label="Search families">
    <div class="fi-row">
      <div class="fi-toggle" role="group" aria-label="Sort">
        <button type="button" id="fiViewName" class="on">A&ndash;Z by Name</button>
        <button type="button" id="fiViewGroup">By Prayer Group</button>
      </div>
      <div class="fi-groups" id="fiGroups"></div>
    </div>
  </div>

  <nav class="fi-az" id="fiAz"></nav>
  <div id="fiList"></div>
</section>

<script>
(function () {
  /*
   * Fed from the database on every page load, in the same order and page
   * numbers as the printed directory (routes/index.js) — there is no
   * separate copy of this data to keep in sync when a family is edited or
   * a CSV is imported.
   */
  const DATA = <%- JSON.stringify(indexEntries) %>;
  const ALL_GROUPS = <%- JSON.stringify(indexGroups) %>;
  const BASE = <%- JSON.stringify(base) %>;

  const els = {
    count: document.getElementById('fiCount'),
    groups: document.getElementById('fiGroups'),
    az: document.getElementById('fiAz'),
    list: document.getElementById('fiList'),
    q: document.getElementById('fiQ'),
    viewName: document.getElementById('fiViewName'),
    viewGroup: document.getElementById('fiViewGroup')
  };

  let state = { q: '', group: 'All', view: 'name' };

  const esc = (s) => String(s).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
  const hl = (text, q) => {
    text = String(text);
    if (!q) return esc(text);
    const i = text.toLowerCase().indexOf(q);
    if (i < 0) return esc(text);
    return esc(text.slice(0, i)) + '<mark class="fi-hit">' + esc(text.slice(i, i + q.length)) + '</mark>' + esc(text.slice(i + q.length));
  };

  function renderGroups() {
    const counts = { All: DATA.length };
    DATA.forEach((d) => { if (d.group) counts[d.group] = (counts[d.group] || 0) + 1; });
    els.groups.innerHTML = ['All', ...ALL_GROUPS].map((g) =>
      `<button type="button" class="fi-chip ${state.group === g ? 'on' : ''}" data-g="${esc(g)}">${esc(g)}<span class="n">${counts[g] || 0}</span></button>`
    ).join('');
    els.groups.querySelectorAll('.fi-chip').forEach((b) => {
      b.onclick = () => { state.group = b.dataset.g; renderGroups(); render(); };
    });
  }

  function filtered() {
    const q = state.q;
    return DATA.filter((d) =>
      (state.group === 'All' || d.group === state.group) &&
      (!q || d.name.toLowerCase().includes(q) || d.code.toLowerCase().includes(q) || d.group.toLowerCase().includes(q))
    );
  }

  function table(rows, showGroup) {
    const q = state.q;
    return `<div class="table-wrap"><table class="table">
      <thead><tr><th style="width:90px">Family ID</th><th>Head of Family</th>${showGroup ? '<th>Prayer Group</th>' : ''}<th class="right" style="width:70px">Page</th></tr></thead>
      <tbody>${rows.map((d) => `<tr>
        <td><span class="tag">${hl(d.code, q)}</span></td>
        <td><a href="${BASE}/families/${d.id}">${hl(d.name, q)}</a></td>
        ${showGroup ? `<td>${d.group ? hl(d.group, q) : ''}</td>` : ''}
        <td class="right num"><a href="${BASE}/directory#folio-${d.page}">${d.page}</a></td></tr>`).join('')}</tbody>
    </table></div>`;
  }

  function render() {
    const rows = filtered();
    els.count.textContent = `Showing ${rows.length} of ${DATA.length} families` + (state.group !== 'All' ? ` · ${state.group}` : '');

    if (!rows.length) {
      els.list.innerHTML = DATA.length
        ? `<p class="empty">No families match &ldquo;${esc(state.q)}&rdquo;.</p>`
        : `<p class="empty">There are no families in the directory yet.</p>`;
      els.az.innerHTML = '';
      return;
    }

    if (state.view === 'name') {
      rows.sort((a, b) => a.name.localeCompare(b.name));
      const byL = {};
      rows.forEach((d) => (byL[(d.name[0] || '#').toUpperCase()] ||= []).push(d));
      els.az.style.display = 'flex';
      els.az.innerHTML = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ'.split('').map((L) =>
        `<a href="#fi-L-${L}" class="${byL[L] ? '' : 'off'}">${L}</a>`).join('');
      els.list.innerHTML = Object.keys(byL).sort().map((L) => `
        <div class="fi-section" id="fi-L-${L}">
          <div class="fi-sec-head"><span class="l">${esc(L)}</span><span class="s">${byL[L].length} ${byL[L].length > 1 ? 'families' : 'family'}</span><span class="line"></span></div>
          ${table(byL[L], true)}
        </div>`).join('');
    } else {
      els.az.style.display = 'none';
      const byG = {};
      rows.forEach((d) => (byG[d.group || 'No Prayer Group'] ||= []).push(d));
      els.list.innerHTML = Object.keys(byG).sort().map((g) => {
        byG[g].sort((a, b) => a.name.localeCompare(b.name));
        return `<div class="fi-section">
          <div class="fi-sec-head"><span class="l">${esc(g)}</span><span class="s">${byG[g].length} ${byG[g].length > 1 ? 'families' : 'family'}</span><span class="line"></span></div>
          ${table(byG[g], false)}
        </div>`;
      }).join('');
    }
  }

  els.q.addEventListener('input', (e) => { state.q = e.target.value.trim().toLowerCase(); render(); });
  const setView = (v) => {
    state.view = v;
    els.viewName.classList.toggle('on', v === 'name');
    els.viewGroup.classList.toggle('on', v === 'group');
    render();
  };
  els.viewName.onclick = () => setView('name');
  els.viewGroup.onclick = () => setView('group');

  renderGroups();
  render();
})();
</script>

<%- include('partials/footer') %>
