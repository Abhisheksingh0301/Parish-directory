<%
  /*
   * One family's proposed changes, as the table the Parish set out: the field,
   * its existing value, its proposed value, and an action on each line.
   *
   * Only changed fields are listed. A reviewer reads three lines, not the whole
   * record, which is what makes a hundred families reviewable in an evening.
   *
   * ── Why the forms sit outside the table ────────────────────────────────────
   * Two things have to be possible on one screen: acting on a single line, and
   * approving a batch. A form cannot be nested inside another, so each line has
   * its own form declared here and the controls in the row join it by `form=`.
   * The batch checkboxes join the enclosing form the caller declared. Nothing
   * depends on JavaScript — every button is a submit button that means one
   * thing.
   *
   * Reused by the queue and by one family's own review page, so the two cannot
   * drift apart.
   */
  const photoUrl = (file) => (file ? `${base}/uploads/${churchId}/${file}` : null);
%>

<% changes.forEach(function (change) { %>
  <form id="line-<%= change.id %>" method="post" action="<%= base %>/review/decide" hidden>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input type="hidden" name="back" value="<%= back %>">
    <input type="hidden" name="change_ids" value="<%= change.id %>">
  </form>
<% }); %>

<div class="table-wrap">
  <table class="table diff">
    <thead>
      <tr>
        <th style="width:34px"><span class="sr-only">Select</span></th>
        <th>Field</th>
        <th>Existing value</th>
        <th>Proposed value</th>
        <th class="right">Action</th>
      </tr>
    </thead>
    <tbody>
      <% changes.forEach(function (change) { %>
        <%
          const clearable = mayClear.includes(change.tier);
          const isPhoto = change.kind === 'family' && change.field === 'photo';
          const composition = change.kind === 'member_add' || change.kind === 'member_remove';
        %>
        <tr class="<%= composition ? 'composition' : '' %>">
          <td>
            <input type="checkbox" name="change_ids" value="<%= change.id %>"
                   form="<%= batchForm %>"
                   aria-label="Select <%= change.label %>"
                   <%= clearable ? '' : 'disabled' %>>
          </td>

          <td>
            <%= change.label %>
            <% if (twoTier) { %>
              <span class="tag <%= change.tier === 'routine' ? 'ok' : 'draft' %>"><%= tiers[change.tier].label %></span>
            <% } %>
          </td>

          <td class="was">
            <% if (isPhoto) { %>
              <% if (change.payload.previous) { %>
                <div class="photo-box small">
                  <img src="<%= photoUrl(change.payload.previous) %>" alt="Photograph currently on record">
                </div>
              <% } else { %>&mdash;<% } %>
            <% } else if (change.existing_value) { %>
              <%- nl2br(change.existing_value) %>
            <% } else { %>&mdash;<% } %>
          </td>

          <td class="now">
            <% if (isPhoto) { %>
              <% if (change.payload.photo) { %>
                <div class="photo-box small">
                  <img src="<%= photoUrl(change.payload.photo) %>" alt="Photograph the family proposes">
                </div>
              <% } else { %><em>Photograph removed</em><% } %>
            <% } else if (change.proposed_value) { %>
              <%- nl2br(change.proposed_value) %>
            <% } else { %><em>Cleared</em><% } %>
          </td>

          <td class="right">
            <% if (clearable) { %>
              <div class="line-actions">
                <button type="submit" class="btn small" form="line-<%= change.id %>"
                        name="outcome" value="approve">Approve</button>
                <button type="submit" class="btn ghost small" form="line-<%= change.id %>"
                        name="outcome" value="reject">Reject</button>
                <input type="text" form="line-<%= change.id %>" name="reason"
                       placeholder="Reason, if rejecting" maxlength="300"
                       aria-label="Reason for rejecting <%= change.label %>">
              </div>
            <% } else { %>
              <span class="hint">Achen or an administrator</span>
            <% } %>
          </td>
        </tr>
      <% }); %>
    </tbody>
  </table>
</div>

<p class="help">
  Each line is approved or rejected on its own. A new mobile number can be
  accepted and a proposed address rejected in the same submission, with the
  rest of the record left untouched. A rejection may carry a short reason,
  which the family sees the next time it signs in.
</p>
