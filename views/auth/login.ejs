<!DOCTYPE html>
<html lang="en">
<head>
<%- include('../partials/head-assets') %>
<title><%= title %> · <%= settings.parish_name %></title>
<link rel="stylesheet" href="<%= base %>/stylesheets/app.css">
</head>
<body class="auth split">

<%- include('../partials/auth-plate') %>

<section class="auth-stage">
  <div class="auth-card">
    <p class="eyebrow">Welcome back</p>
    <h1>Sign in to the directory</h1>
    <p class="lede">
      Access your family&rsquo;s entry, or manage records on behalf of the
      parish office.
    </p>

    <%- include('../partials/messages') %>

    <form method="post" action="<%= base %>/login" autocomplete="on">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <div class="field">
        <label for="username">Username</label>
        <input type="text" id="username" name="username" value="<%= username %>"
               autocomplete="username" autofocus required>
      </div>

      <div class="field">
        <label for="password">Password</label>
        <input type="password" id="password" name="password"
               autocomplete="current-password" required>
      </div>

      <button type="submit" class="btn">Sign in</button>
    </form>

    <p class="alt">
      No email on file? A family can sign in with its
      <a href="<%= base %>/family-login">Family ID and PIN</a> instead.
    </p>
  </div>

  <%- include('../partials/indus-badge') %>
</section>

<script src="<%= base %>/javascripts/password-toggle.js"></script>
</body>
</html>
