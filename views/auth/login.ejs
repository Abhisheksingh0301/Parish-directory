<!DOCTYPE html>
<html lang="en">
<head>
<%- include('../partials/head-assets') %>
<title><%= title %> · <%= settings.parish_name %></title>
<link rel="stylesheet" href="<%= base %>/stylesheets/app.css">
</head>
<body class="auth">

<div class="auth-card">
  <h1><%= settings.directory_title %></h1>
  <p class="parish"><%= settings.parish_name %></p>

  <%- include('../partials/messages') %>

  <form method="post" action="<%= base %>/login" autocomplete="on">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

    <div class="field">
      <label for="username">Username</label>
      <input type="text" id="username" name="username" value="<%= username %>"
             autocomplete="username" autofocus required>
    </div>

    <div class="field">
      <label for="password">Password</label>
      <input type="password" id="password" name="password"
             autocomplete="current-password" required>
    </div>

    <button type="submit" class="btn">Sign in</button>
  </form>

  <p class="help" style="margin-top:18px">
    A family with no email address on file signs in with its
    <a href="<%= base %>/family-login">Family ID and PIN</a> instead.
  </p>
</div>

<%- include('../partials/indus-badge') %>

<script src="<%= base %>/javascripts/password-toggle.js"></script>
</body>
</html>
