<%- include('../partials/header') %>

<div class="page-head">
  <h1>System overview</h1>
  <p class="sub">
    Every <%= labels.diocese.toLowerCase() %>, <%= labels.zone.toLowerCase() %>
    and church in this installation.
  </p>
</div>

<%- include('../partials/messages') %>

<div class="stats">
  <div class="stat"><div class="n"><%= counts.dioceses %></div><div class="k"><%= labels.diocese %>s</div></div>
  <div class="stat"><div class="n"><%= counts.zones %></div><div class="k"><%= labels.zone %>s</div></div>
  <div class="stat"><div class="n"><%= counts.churches %></div><div class="k">Churches</div></div>
  <div class="stat"><div class="n"><%= counts.families %></div><div class="k">Families</div></div>
  <div class="stat"><div class="n"><%= counts.members %></div><div class="k">People</div></div>
  <div class="stat"><div class="n"><%= counts.users %></div><div class="k">Accounts</div></div>
</div>

<div class="card" style="padding:0;overflow:hidden">
  <div class="table-wrap">
    <table class="table">
      <thead>
        <tr>
          <th><%= labels.diocese %></th>
          <th class="right"><%= labels.zone %>s</th>
          <th class="right">Churches</th>
          <th class="right">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% if (!dioceses.length) { %>
          <tr>
            <td colspan="4" class="empty">
              No <%= labels.diocese.toLowerCase() %>s yet.
            </td>
          </tr>
        <% } %>
        <% dioceses.forEach(function (d) { %>
          <tr>
            <td>
              <%= d.name %>
              <% if (!d.is_active) { %><span class="tag draft">Deactivated</span><% } %>
            </td>
            <td class="right"><%= d.zone_count %></td>
            <td class="right"><%= d.church_count %></td>
            <td class="right nowrap">
              <a class="btn ghost small" href="<%= base %>/super/churches?diocese=<%= d.id %>">Churches</a>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
</div>

<div class="card">
  <h2>Getting started</h2>
  <p class="help">
    Add a church, and it comes with the account that will run it, so it is
    usable the moment it exists. There is no
    <%= labels.diocese.toLowerCase() %> or <%= labels.zone.toLowerCase() %> to
    set up first. Organising churches into
    <%= labels.diocese.toLowerCase() %>s and
    <%= labels.zone.toLowerCase() %>s is optional, for installs that want it.
  </p>
  <div class="actions">
    <a class="btn" href="<%= base %>/super/churches">Manage churches</a>
    <a class="btn ghost" href="<%= base %>/super/dioceses">Manage <%= labels.diocese.toLowerCase() %>s</a>
    <a class="btn ghost" href="<%= base %>/super/zones">Manage <%= labels.zone.toLowerCase() %>s</a>
  </div>
</div>

<%- include('../partials/footer') %>
