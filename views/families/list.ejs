<%- include('../partials/header') %>

<div class="page-head">
  <h1>Families</h1>
  <div class="spacer"></div>
  <div class="actions" style="margin:0">
    <form method="get" action="<%= base %>/families" style="display:flex;gap:8px">
      <input type="search" name="q" value="<%= search %>" placeholder="Search name, ID, address, mobile…"
             style="min-width:260px" aria-label="Search families">
      <button type="submit" class="btn ghost">Search</button>
      <% if (search) { %><a href="<%= base %>/families" class="btn ghost">Clear</a><% } %>
    </form>
    <a href="<%= base %>/families/status" class="btn ghost">Verification status</a>
    <% if (canEdit) { %><a href="<%= base %>/families/new" class="btn">Add a family</a><% } %>
  </div>
</div>

<%- include('../partials/messages') %>

<% if (canEdit) { %>
  <%
    const emailList = allEmails.join(', ');
    // Mail clients and browsers truncate very long mailto: links, so the
    // button only appears while it is short enough to survive the trip.
    const mailtoUsable = emailList.length > 0 && emailList.length < 1800;
  %>
  <details class="card invite" <%= pendingLoginCount ? 'open' : '' %>>
    <summary>
      Invite families to complete their own entry
      <span class="hint">
        — <%= allEmails.length %> <%= allEmails.length === 1 ? 'address' : 'addresses' %> on file<%
        %><% if (isAdmin && pendingLoginCount) { %>, <%= pendingLoginCount %> without a login yet<% } %>
      </span>
    </summary>

    <p class="help" style="margin-top:12px">
      Every family with an email address can be given a login. They sign in with
      that address and the password below, and may correct their own entry —
      their address, their members, their photograph — and nothing else.
    </p>

    <div class="field">
      <div class="label">The password every member login in this church is created with</div>
      <p class="default-password"><%= defaultPassword %></p>
      <p class="help">
        Set by <code>DEFAULT_USER_PASSWORD</code> in this install&rsquo;s <code>.env</code> file.
        Put it in the email you send; each family is asked to change it once they are in.
      </p>
    </div>

    <% if (isAdmin) { %>
      <form method="post" action="<%= base %>/families/logins" style="margin-bottom:18px"
            onsubmit="return confirm('Create logins for <%= pendingLoginCount %> famil<%= pendingLoginCount === 1 ? 'y' : 'ies' %>?')">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button type="submit" class="btn" <%= pendingLoginCount ? '' : 'disabled' %>>
          <% if (pendingLoginCount) { %>
            Create <%= pendingLoginCount %> family <%= pendingLoginCount === 1 ? 'login' : 'logins' %>
          <% } else { %>
            Every family with an email already has a login
          <% } %>
        </button>
      </form>
    <% } %>

    <div class="field">
      <div class="label">All family email addresses, separated by commas</div>

      <% if (!allEmails.length) { %>
        <p class="help">No family has an email address yet.</p>
      <% } else { %>
        <textarea id="all-emails" rows="4" readonly aria-label="All family email addresses"><%= emailList %></textarea>

        <div class="actions" style="margin-top:10px">
          <button type="button" class="btn ghost" data-copy-emails>Copy all addresses</button>
          <% if (mailtoUsable) { %>
            <a class="btn ghost" href="mailto:?bcc=<%= encodeURIComponent(emailList) %>&subject=<%= encodeURIComponent('Please complete your entry in the ' + settings.directory_title) %>">
              Open in your email programme
            </a>
          <% } %>
        </div>

        <p class="help" style="margin-top:8px">
          Send it as <strong>Bcc</strong>, so no family sees another family&rsquo;s address.
        </p>
      <% } %>
    </div>
  </details>
<% } %>

<div class="card" style="padding:0;overflow:hidden">
  <% if (!families.length) { %>
    <div class="empty">
      <% if (search) { %>
        No families match &ldquo;<%= search %>&rdquo;.
      <% } else { %>
        No families yet.
        <% if (canEdit) { %><br><a href="<%= base %>/families/new">Add the first one</a>.<% } %>
      <% } %>
    </div>
  <% } else { %>
    <div class="table-wrap">
      <table class="table">
        <thead>
          <tr>
            <th style="width:90px">ID</th>
            <th>Family head</th>
            <th>Address</th>
            <th class="nowrap">Members</th>
            <th class="nowrap">Verification</th>
            <th class="nowrap">DOM</th>
            <% if (isAdmin) { %><th class="nowrap">Login</th><% } %>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% families.forEach(function (f) { %>
            <tr>
              <td class="nowrap"><strong><%= f.family_id %></strong></td>
              <td>
                <a href="<%= base %>/families/<%= f.id %>"><%= f.head_name %></a>
                <% if (!f.is_published) { %><span class="tag draft">Draft</span><% } %>
              </td>
              <td style="color:var(--ink-faint)"><%= f.address.split('\n')[0] %></td>
              <td class="nowrap"><%= f.member_count %></td>
              <td class="nowrap">
                <span class="tag"><%= statusLabel(f.verify_status) %></span>
              </td>
              <td class="nowrap"><%= f.dom || '—' %></td>
              <% if (isAdmin) { %>
                <td class="nowrap">
                  <% if (!f.login_id) { %>
                    <span style="color:var(--ink-faint)"><%= f.email ? 'none yet' : '—' %></span>
                  <% } else if (!f.login_active) { %>
                    <span class="tag draft">Deactivated</span>
                  <% } else if (f.login_on_default_password) { %>
                    <span class="tag">Default password</span>
                  <% } else { %>
                    <span class="tag ok">Signed up</span>
                  <% } %>
                </td>
              <% } %>
              <td class="right nowrap">
                <% if (canEdit) { %>
                  <a href="<%= base %>/families/<%= f.id %>/edit" class="btn ghost small">Edit</a>
                <% } %>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>

<% if (families.length) { %>
  <p class="help" style="color:var(--ink-faint);font-size:14px">
    <%= families.length %> <%= families.length === 1 ? 'family' : 'families' %> shown.
  </p>
<% } %>

<script src="<%= base %>/javascripts/copy-emails.js"></script>

<%- include('../partials/footer') %>
