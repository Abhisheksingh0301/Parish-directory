<%- include('../partials/header') %>

<div class="page-head">
  <h1>
    <%= family.head_name %>
    <% if (!family.is_published) { %><span class="tag draft">Draft</span><% } %>
  </h1>
  <div class="spacer"></div>
  <div class="actions" style="margin:0">
    <a href="/families" class="btn ghost">Back to families</a>
    <% if (canEdit) { %><a href="/families/<%= family.id %>/edit" class="btn">Edit</a><% } %>
  </div>
</div>

<div class="detail-grid">
  <div class="card">
    <h2>Family ID <%= family.family_id %></h2>

    <dl>
      <dt>Address</dt>
      <dd><%- family.address ? nl2br(family.address) : '&mdash;' %></dd>

      <dt>Hometown address</dt>
      <dd><%= family.hometown || '—' %></dd>

      <dt>Home parish</dt>
      <dd><%= family.home_parish || '—' %></dd>

      <dt>Spouse home</dt>
      <dd><%= family.spouse_home || '—' %></dd>

      <dt>Email ID</dt>
      <dd>
        <% if (family.email) { %>
          <a href="mailto:<%= family.email %>"><%= family.email %></a>
        <% } else { %>—<% } %>
      </dd>

      <dt>Date of marriage</dt>
      <dd><%= family.dom || '—' %></dd>
    </dl>
  </div>

  <div class="card">
    <h2>Photograph</h2>
    <div class="photo-box">
      <% if (family.photo) { %>
        <img src="/uploads/<%= family.photo %>" alt="Photograph of the <%= family.head_name %> family">
      <% } else { %>
        <div class="none">No photograph</div>
      <% } %>
    </div>
  </div>
</div>

<div class="card">
  <h2>Family members <span class="hint">— <%= family.members.length %></span></h2>

  <div class="table-wrap">
    <table class="table">
      <thead>
        <tr>
          <th>Name</th>
          <th>Reltn</th>
          <th>DOB</th>
          <th>Mobile</th>
          <th>Links</th>
        </tr>
      </thead>
      <tbody>
        <% family.members.forEach(function (m) { %>
          <tr>
            <td><%= m.name %></td>
            <td><%= m.relation || '—' %></td>
            <td class="nowrap"><%= m.dob || '—' %></td>
            <td class="nowrap"><%= m.mobile || '—' %></td>
            <td><%= m.links || '—' %></td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>

  <p class="help" style="margin-top:12px">
    Dates of birth and the date of marriage are day and month only — no year is stored.
  </p>
</div>

<%- include('../partials/footer') %>
