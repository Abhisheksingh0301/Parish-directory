<%- include('../partials/header') %>

<div class="page-head">
  <h1>
    <%= family.head_name %>
    <% if (!family.is_published) { %><span class="tag draft">Draft</span><% } %>
  </h1>
  <div class="spacer"></div>
  <div class="actions" style="margin:0">
    <% if (!isOwnEntry) { %><a href="<%= base %>/families" class="btn ghost">Back to families</a><% } %>
    <% if (canEdit) { %>
      <a href="<%= base %>/families/<%= family.id %>/edit" class="btn">
        <%= isOwnEntry ? 'Complete our entry' : 'Edit' %>
      </a>
    <% } %>
  </div>
</div>

<%- include('../partials/messages') %>

<% if (isOwnEntry) { %>
  <div class="card">
    <p style="margin:0">
      This is your family&rsquo;s entry in the <%= settings.directory_title %>.
      Please check it, fill in anything missing and correct anything wrong.
      Nothing you send changes this record on its own — the parish office
      approves each correction first, and it is printed exactly as it stands
      here once they have.
    </p>
  </div>
<% } %>

<%
  /*
   * What has become of this family's corrections.
   *
   * Shown to the family as well as to staff, and the rejections carry the
   * reason the reviewer gave — so a correction that was turned down is not
   * silently lost, and the household knows to ask about it rather than
   * assuming the form did not work.
   *
   * Every rejection is listed, including the ones with no reason against them.
   * This used to keep only those that carried a reason, which quietly undid
   * the promise above: the box on the review screen reads "Reason, if
   * rejecting" and is optional, so a reviewer clearing a queue rejects several
   * lines without typing one, and the family was shown whichever single
   * correction had happened to be explained — with no sign that the others had
   * been decided at all. A rejection with nothing written against it says so.
   */
  const SHOWN = 8;
  const waiting = proposals.waiting;
  const rejected = proposals.rejected.slice(0, SHOWN);
  const rejectedMore = proposals.rejected.length - rejected.length;
  const approved = proposals.approved.slice(0, SHOWN);
  const approvedMore = proposals.approved.length - approved.length;
%>

<% if (waiting.length) { %>
  <div class="card">
    <h2>
      <%= isOwnEntry ? 'Sent to the parish office' : 'Waiting for review' %>
      <span class="hint">— <%= waiting.length %></span>
    </h2>

    <p class="help" style="margin-top:-8px">
      <% if (isOwnEntry) { %>
        These corrections have been received. They are not in the directory yet;
        they appear here once the parish office has approved them.
      <% } else { %>
        This family has proposed these changes. The record above is unchanged
        until they are approved.
      <% } %>
    </p>

    <div class="table-wrap">
      <table class="table">
        <thead>
          <tr><th>Field</th><th>Existing value</th><th>Proposed value</th></tr>
        </thead>
        <tbody>
          <% waiting.forEach(function (c) { %>
            <tr>
              <td><%= c.label %></td>
              <td style="color:var(--ink-faint)"><%= c.existing_value || '—' %></td>
              <td><%= c.proposed_value || '—' %></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>

    <% if (!isOwnEntry && canEdit) { %>
      <div class="actions">
        <a href="<%= base %>/review/<%= family.id %>" class="btn">Review these changes</a>
      </div>
    <% } %>
  </div>
<% } %>

<% if (rejected.length || approved.length) { %>
  <div class="card">
    <h2>What the parish office decided</h2>

    <% if (rejected.length) { %>
      <div class="alert error" style="margin-bottom:14px">
        <strong>Not applied:</strong>
        <ul>
          <% rejected.forEach(function (c) { %>
            <li>
              <strong><%= c.label %></strong> — <%= c.proposed_value || 'cleared' %>.
              <% if (c.reason) { %>
                <%= c.reason %>
              <% } else { %>
                <span class="hint">No reason was recorded — ask the parish office.</span>
              <% } %>
            </li>
          <% }); %>
        </ul>
        <% if (rejectedMore) { %>
          <p class="help" style="margin:0">
            And <%= rejectedMore %> other<%= rejectedMore === 1 ? '' : 's' %>,
            older than these.
          </p>
        <% } %>
      </div>
    <% } %>

    <% if (approved.length) { %>
      <p class="help" style="margin-top:0">
        Applied to the directory:
        <%= approved.map(function (c) { return c.label; }).join('; ') %><%
        %><% if (approvedMore) { %>, and <%= approvedMore %> other<%= approvedMore === 1 ? '' : 's' %><% } %>.
      </p>
    <% } %>
  </div>
<% } %>

<div class="detail-grid">
  <div class="card">
    <h2>Family ID <%= family.family_id %></h2>

    <%# The order the Parish reads an entry in. lib/verification.js holds the
        same order and the same labels for the review screen and the export;
        this list follows it rather than inventing a second one. %>
    <dl>
      <dt>Residence</dt>
      <dd><%- family.address ? nl2br(family.address) : '&mdash;' %></dd>

      <dt>Prayer Group</dt>
      <dd><%= family.prayer_group || '—' %></dd>

      <dt>Area / Unit</dt>
      <dd><%= family.area || '—' %></dd>

      <dt>Home Parish (HOF)</dt>
      <dd><%= family.home_parish || '—' %></dd>

      <dt>Home Town Name / Address (HOF)</dt>
      <dd><%- family.hometown ? nl2br(family.hometown) : '&mdash;' %></dd>

      <dt>Email ID</dt>
      <dd>
        <% if (family.email) { %>
          <a href="mailto:<%= family.email %>"><%= family.email %></a>
        <% } else { %>—<% } %>
      </dd>

      <dt>Verification</dt>
      <dd><span class="tag"><%= statusLabel %></span></dd>
    </dl>
  </div>

  <div class="card">
    <h2>Photograph</h2>
    <div class="photo-box">
      <% if (family.photo) { %>
        <img src="<%= family.photo_url %>" alt="Photograph of the <%= family.head_name %> family">
      <% } else { %>
        <div class="none">No photograph</div>
      <% } %>
    </div>
  </div>
</div>

<div class="card">
  <h2>Family members <span class="hint">— <%= family.members.length %></span></h2>

  <div class="table-wrap">
    <table class="table">
      <thead>
        <tr>
          <th>Name</th>
          <th>Relation</th>
          <th>Date of birth</th>
          <th>Date of marriage</th>
          <th>Mobile</th>
          <th>Blood group</th>
          <th>Qualification</th>
          <th>Occupation</th>
          <th>Emails</th>
        </tr>
      </thead>
      <tbody>
        <% family.members.forEach(function (m) { %>
          <tr>
            <td><%= m.name %></td>
            <td><%= m.relation || '—' %></td>
            <td class="nowrap"><%= m.dob || '—' %></td>
            <td class="nowrap"><%= m.dom || '—' %></td>
            <td class="nowrap">
              <% if (!m.mobiles.length) { %>—<% } %>
              <% m.mobiles.forEach(function (n, j) { %><%
                %><%= n %><% if (j < m.mobiles.length - 1) { %><br><% } %><% }) %>
            </td>
            <td class="nowrap"><%= m.blood_group || '—' %></td>
            <td><%= m.qualification || '—' %></td>
            <td><%= m.occupation || '—' %></td>
            <td>
              <% if (!m.email_list.length) { %>—<% } %>
              <% m.email_list.forEach(function (a, j) { %><%
                %><a href="mailto:<%= a %>"><%= a %></a><%
                %><% if (j < m.email_list.length - 1) { %><br><% } %><% }) %>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>

  <p class="help" style="margin-top:12px">
    Both dates are day and month only — no year is stored for either. A date of
    marriage belongs to the member, so a household with more than one married
    couple in it records each of them.
  </p>
</div>

<% if (isAdmin) { %>
  <div class="card">
    <h2>Member login</h2>

    <% if (login) { %>
      <dl>
        <dt>Signs in as</dt>
        <dd><%= login.username %></dd>

        <dt>Password</dt>
        <dd>
          <% if (login.on_default_password) { %>
            still the default — <code><%= defaultPassword %></code>
          <% } else { %>
            chosen by the family
          <% } %>
        </dd>

        <dt>Last signed in</dt>
        <dd><%= login.last_login_at || 'never' %></dd>
      </dl>

      <div class="actions" style="margin-top:0">
        <form method="post" action="<%= base %>/families/<%= family.id %>/login"
              onsubmit="return confirm('Put <%= login.username %> back to the default password?')">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button type="submit" class="btn ghost small">Reset to the default password</button>
        </form>

        <form method="post" action="<%= base %>/families/<%= family.id %>/pin"
              onsubmit="return confirm('Issue a new PIN? Any PIN already handed to this family stops working.')">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button type="submit" class="btn ghost small">Issue a new PIN and slip</button>
        </form>
      </div>

      <p class="help">
        There are no password reset links anywhere in this application — a
        family that has forgotten its password has it reset here, by the parish
        administrator. That is what makes a household with no email address
        workable.
      </p>
    <% } else if (family.email) { %>
      <p class="help" style="margin-top:0">
        No login yet. Creating one lets this family sign in as
        <strong><%= family.email %></strong> with the default password
        (<code><%= defaultPassword %></code>) and complete their own entry.
      </p>
      <form method="post" action="<%= base %>/families/<%= family.id %>/login">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button type="submit" class="btn">Create a login for this family</button>
      </form>
    <% } else { %>
      <p class="help" style="margin-top:0">
        This family has no email address — which excludes it from nothing. Issue
        a verification slip and it signs in with its Family ID
        (<strong><%= family.family_id %></strong>) and the PIN printed on the
        slip. No email address is involved at any step.
      </p>
      <form method="post" action="<%= base %>/families/<%= family.id %>/pin">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button type="submit" class="btn">Issue a Family ID and PIN slip</button>
      </form>
    <% } %>
  </div>
<% } %>

<%- include('../partials/footer') %>
