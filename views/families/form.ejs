<%- include('../partials/header') %>

<%
  // One markup definition for a member row, reused for the saved members and
  // for the <template> the "Add member" button clones.
  function memberRow(index, m) {
%>
  <div class="member-row" data-member-row>
    <%
      /*
       * A saved member carries its id back. Without it a correction to "the
       * second row's mobile number" would have to be matched by position, and
       * a pending change waiting in the review queue would land on whoever
       * happened to be second by the time it was approved.
       */
    %>
    <input type="hidden" name="members[<%= index %>][id]" value="<%= m.id || '' %>">

    <div class="field">
      <label>Name</label>
      <input type="text" name="members[<%= index %>][name]" value="<%= m.name %>"
             placeholder="Mr. John Dsouza">
    </div>

    <div class="field">
      <label>Relation</label>
      <input type="text" name="members[<%= index %>][relation]" value="<%= m.relation %>"
             list="relation-codes" placeholder="Head">
    </div>

    <%
      /*
       * Both dates are day and month, and both are the same pair of controls.
       * A date picker cannot hold a day and month with no year, which is why
       * the date of birth stopped being one: the directory records when to
       * wish a member, not how old they are.
       */
      function memberDate(key, label, dayLabel, monthLabel) {
    %>
      <div class="field">
        <div class="label"><%= label %></div>
        <div class="daymonth">
          <input type="number" name="members[<%= index %>][<%= key %>_day]"
                 min="1" max="31" value="<%= m[key + '_day'] || '' %>"
                 placeholder="Day" aria-label="<%= dayLabel %>">
          <select name="members[<%= index %>][<%= key %>_month]" aria-label="<%= monthLabel %>">
            <option value="">Month</option>
            <% months.forEach(function (mo) { %>
              <option value="<%= mo.value %>"
                <%= Number(m[key + '_month']) === mo.value ? 'selected' : '' %>><%= mo.name %></option>
            <% }); %>
          </select>
        </div>
      </div>
    <% } %>

    <% memberDate('dob', 'Date of birth', 'Day of birth', 'Month of birth'); %>
    <% memberDate('dom', 'Date of marriage', 'Day of marriage', 'Month of marriage'); %>

    <div class="field">
      <label>Mobile</label>
      <%# data-tags turns this into the chip editor in tag-input.js. Without
          that script it stays exactly what it is here: one box holding a
          comma-separated list, with its own pattern and title. %>
      <input type="text" name="members[<%= index %>][mobile]" value="<%= m.mobile %>"
             inputmode="numeric" autocomplete="tel-national" data-mobile
             data-tags data-tag-max="<%= maxMobiles %>"
             data-tag-pattern="<%= mobilePatternOne %>"
             data-tag-strip="[\s()\-.]"
             maxlength="<%= mobileMaxInput %>" pattern="<%= mobilePattern %>"
             title="Up to <%= maxMobiles %> numbers, one at a time — type a number and press comma. Each is <%= mobileDigits %> digits beginning with 6, 7, 8 or 9, like 9876543210. A leading 0 is fine; letters and a country code are not."
             placeholder="9876543210, then comma">
    </div>

    <div class="field">
      <label>Blood group</label>
      <select name="members[<%= index %>][blood_group]">
        <% bloodGroupOptions.forEach(function (bg) { %>
          <option value="<%= bg %>" <%= m.blood_group === bg ? 'selected' : '' %>><%= bg || '—' %></option>
        <% }); %>
      </select>
    </div>

    <div class="field">
      <label>Qualification</label>
      <input type="text" name="members[<%= index %>][qualification]" value="<%= m.qualification %>"
             maxlength="<%= textLimits.qualification %>" pattern="<%= textPattern('qualification') %>"
             title="Up to <%= textLimits.qualification %> characters, with at least one letter in it."
             placeholder="B.Sc. Nursing">
    </div>

    <div class="field">
      <label>Occupation</label>
      <input type="text" name="members[<%= index %>][occupation]" value="<%= m.occupation %>"
             maxlength="<%= textLimits.occupation %>" pattern="<%= textPattern('occupation') %>"
             title="Up to <%= textLimits.occupation %> characters, with at least one letter in it."
             placeholder="Staff Nurse">
    </div>

    <div class="field">
      <label>Emails</label>
      <input type="text" name="members[<%= index %>][emails]" value="<%= m.emails %>"
             inputmode="email"
             data-tags data-tag-max="<%= maxEmails %>"
             data-tag-pattern="<%= emailPattern %>"
             pattern="<%= emailListPattern %>"
             title="Up to <%= maxEmails %> addresses, one at a time — type an address and press comma. Each needs a full domain ending, like name@example.com."
             placeholder="name@example.com, then comma">
    </div>

    <div class="drop">
      <button type="button" class="btn ghost small" data-remove-member>Remove</button>
    </div>
  </div>
<% } %>

<div class="page-head">
  <h1><%= isNew ? 'Add a family' : (isOwnEntry ? 'Our entry' : 'Edit family') %></h1>
  <p class="sub">
    <% if (isOwnEntry) { %>
      Fill in whatever is missing and correct anything that is wrong. Your family
      ID and whether the entry is printed are set by the parish office.
    <% } %>
    A date of birth is picked as a full date, and a son or daughter has to be
    younger than their parents. The date of marriage is day and month only —
    no year, in the form or in the printed directory.
  </p>
</div>

<%- include('../partials/messages') %>

<datalist id="relation-codes">
  <% relationOptions.forEach(function (code) { %><option value="<%= code %>"><% }); %>
</datalist>

<%
  // Offered rather than enforced: an Area or a Prayer Group that does not exist
  // yet has to be typeable, or the first family in a new one cannot be entered.
%>
<datalist id="area-names">
  <% groupings.areas.forEach(function (name) { %><option value="<%= name %>"><% }); %>
</datalist>
<datalist id="prayer-group-names">
  <% groupings.prayerGroups.forEach(function (name) { %><option value="<%= name %>"><% }); %>
</datalist>
<datalist id="parish-names">
  <% parishNames.forEach(function (name) { %><option value="<%= name %>"><% }); %>
</datalist>

<form method="post"
      action="<%= base + (isNew ? '/families' : '/families/' + family.id) %>"
      enctype="multipart/form-data">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">

  <div class="card">
    <h2>The family</h2>

    <div class="grid-2">
      <div class="field">
        <label for="family_id">Family ID</label>
        <% if (isOwnEntry) { %>
          <input type="text" id="family_id" value="<%= family.family_id %>" disabled>
          <p class="help">Given to your family by the parish office.</p>
        <% } else { %>
          <input type="text" id="family_id" name="family_id" value="<%= family.family_id %>" required>
          <p class="help">Prints in the corner of the entry. Any format your parish already uses.</p>
        <% } %>
      </div>

      <div class="field">
        <label for="head_name">Family head</label>
        <input type="text" id="head_name" name="head_name" value="<%= family.head_name %>" required>
        <p class="help">
          Prints in the large band at the top of the entry. Kept the same as
          the first family member below — type it in either place, and the
          other follows, until you deliberately make the two different.
        </p>
      </div>
    </div>

    <%
      // The two addresses sit side by side because they are read together —
      // where the family lives now, and where the family is from. The tick
      // below comes back ticked when the two are already the same.
      const addressText = String(family.address || '').trim();
      const hometownText = String(family.hometown || '').trim();
      const sameAddress = !!hometownText && hometownText === addressText;
    %>
    <%# The order the Parish reads an entry in — the same order as
        lib/verification.js, views/families/show.ejs and the printed book. %>
    <div class="grid-2 address-pair">
      <div class="field">
        <label for="address">Residence</label>
        <textarea id="address" name="address"
                  placeholder="Flat no., Building name, Street,&#10;Locality, City — 000000"><%= family.address %></textarea>
        <p class="help">Line breaks are preserved in the printed entry.</p>
      </div>

      <div class="field">
        <label for="hometown">Home Town Name / Address (HOF)</label>
        <textarea id="hometown" name="hometown"
                  placeholder="House name, Village"><%= family.hometown %></textarea>
        <p class="help">Where the head of the family is originally from.</p>
        <label class="checkline same-address" hidden>
          <input type="checkbox" id="same-address" <%= sameAddress ? 'checked' : '' %>>
          Same as the residence above
        </label>
      </div>
    </div>

    <div class="grid-2">
      <div class="field">
        <label for="prayer_group">Prayer Group</label>
        <input type="text" id="prayer_group" name="prayer_group" value="<%= family.prayer_group %>"
               list="prayer-group-names">
      </div>

      <div class="field">
        <label for="area">Area / Unit</label>
        <input type="text" id="area" name="area" value="<%= family.area || '' %>"
               list="area-names">
        <p class="help">
          The division an Area Representative follows up. Verification status
          can be read, and the follow-up sheet printed, one Area at a time.
        </p>
      </div>

      <div class="field">
        <label for="home_parish">Home Parish (HOF)</label>
        <input type="text" id="home_parish" name="home_parish" value="<%= family.home_parish %>"
               list="parish-names" autocomplete="off"
               placeholder="Start typing a parish name">
        <p class="help">
          Pick from the churches on record, or type one that is not listed.
        </p>
      </div>

      <div class="field">
        <label for="email">Email ID</label>
        <input type="email" id="email" name="email" value="<%= family.email %>"
               pattern="<%= emailPattern %>"
               title="A full email address, ending in .com, .in and so on — like name@example.com">
        <p class="help">
          Doubles as the family&rsquo;s sign-in name. Each member has their own
          Emails field in the row below.
        </p>
      </div>

      <% if (!isOwnEntry) { %>
        <div class="field">
          <div class="label">In the printed directory</div>
          <label class="checkline" style="text-transform:none;font-weight:500;letter-spacing:0">
            <input type="checkbox" name="is_published" value="1"
                   <%= family.is_published ? 'checked' : '' %>>
            Include this family when printing
          </label>
          <p class="help">Untick to keep it as a draft while details are still being collected.</p>
        </div>
      <% } %>
    </div>
  </div>

  <div class="card">
    <h2>Photograph <span class="hint">— optional, printed at 4:3</span></h2>

    <div class="grid-2">
      <div class="field">
        <label for="photo">Upload a photo</label>
        <input type="file" id="photo" name="photo" accept="image/jpeg,image/png,image/webp,image/gif">
        <p class="help">JPG, PNG, WebP or GIF, landscape (wider than tall), up to <%= maxPhotoMb %> MB.</p>
      </div>

      <% if (family.photo) { %>
        <div class="field">
          <div class="label">Current photo</div>
          <div class="photo-box" style="max-width:220px">
            <img src="<%= family.photo_url %>" alt="Current photograph of the family">
          </div>
          <label class="checkline" style="margin-top:10px">
            <input type="checkbox" name="remove_photo" value="1">
            Remove this photo
          </label>
        </div>
      <% } %>
    </div>
  </div>

  <div class="card">
    <h2>Family members</h2>
    <p class="help" style="margin:-8px 0 14px">
      The first two rows share the Date of marriage cell in the printed table,
      matching the directory layout — so put the spouse second. If the second
      row is a son or daughter, the cell stays on the first row instead, rather
      than reading as a child&rsquo;s wedding date. Rows with an empty name are
      ignored.
    </p>

    <div class="members-editor" id="members-editor">
      <% family.members.forEach(function (m, i) { memberRow(i, m); }); %>
    </div>

    <div class="actions">
      <button type="button" class="btn ghost" id="add-member">Add another member</button>
    </div>

    <%
      /*
       * Relation is a free-text field with suggestions, so any relation can be
       * typed into a row already. What this adds is making one stick: typed
       * into the box below it joins the list every family form offers from
       * then on.
       *
       * Administrators only — the list is a parish setting. An editor can
       * still type whatever a household actually is into the row itself.
       */
    %>
    <% if (atLeast('admin')) { %>
      <div class="field add-relation" id="add-relation" hidden style="margin-top:16px"
           data-endpoint="<%= base %>/admin/relations">
        <div class="label">Relations offered</div>
        <div class="daymonth">
          <input type="text" id="new-relation" maxlength="40"
                 placeholder="Father-in-law" aria-label="A relation to add to the list">
          <button type="button" class="btn ghost" id="add-relation-go">Add to the list</button>
        </div>
        <p class="help" id="add-relation-note">
          Adds to the relations every family form suggests. You can also type a
          one-off relation straight into a member row above, or edit the whole
          list under <a href="<%= base %>/admin/settings">Settings</a>.
        </p>
      </div>
    <% } %>
  </div>

  <% if (isOwnEntry) { %>
    <div class="card">
      <h2>What happens when you send this</h2>
      <p class="help" style="margin:0">
        Nothing you send changes the parish directory on its own. Your
        corrections go to the parish office as a proposal, and each one is
        looked at and approved before it reaches the record that is printed.
        You will see what was approved — and the reason for anything that was
        not — the next time you sign in.
      </p>
    </div>
  <% } %>

  <div class="actions">
    <button type="submit" class="btn">
      <%= isNew ? 'Add family' : (isOwnEntry ? 'Send our corrections' : 'Save changes') %>
    </button>
    <a href="<%= base + (isNew ? '/families' : '/families/' + family.id) %>" class="btn ghost">Cancel</a>

    <% if (!isNew) { %>
      <span class="spacer"></span>
    <% } %>
  </div>
</form>

<% if (!isNew && !isOwnEntry) { %>
  <form method="post" action="<%= base %>/families/<%= family.id %>/delete" class="card"
        style="margin-top:24px;border-color:#d9b4aa"
        onsubmit="return confirm('Delete this family and all of its members? This cannot be undone.')">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <h2 style="color:var(--danger)">Delete this family</h2>
    <p class="help" style="margin:-8px 0 14px">
      Deletes the entry, its members and its photograph permanently.
    </p>
    <button type="submit" class="btn danger">Delete <%= family.head_name %></button>
  </form>
<% } %>

<template id="member-template">
  <% memberRow('__INDEX__', {
       id: '', name: '', relation: '',
       dob_day: '', dob_month: '', dom_day: '', dom_month: '', mobile: '',
       blood_group: '', qualification: '', occupation: '', emails: ''
     }); %>
</template>

<script src="<%= base %>/javascripts/same-address.js"></script>
<script src="<%= base %>/javascripts/head-name-sync.js"></script>
<script src="<%= base %>/javascripts/family-form.js"></script>
<script src="<%= base %>/javascripts/day-of-month.js"></script>
<script src="<%= base %>/javascripts/mobile-digits.js"></script>
<script src="<%= base %>/javascripts/tag-input.js"></script>
<script src="<%= base %>/javascripts/add-relation.js"></script>

<%- include('../partials/footer') %>
