<!DOCTYPE html>
<html lang="en">
<head>
<%- include('../partials/head-assets') %>
<title><%= title %> · <%= settings.parish_name %></title>
<link rel="stylesheet" href="<%= base %>/stylesheets/directory.css">
<%
  /*
   * The page margin, which has to follow the book rather than sit in the
   * stylesheet.
   *
   * A sheet carrying one family draws the engraved keyline, and the keyline
   * needs somewhere to sit that is not paid for out of the entry's height
   * budget. So the margin gives up 6mm and .page-single takes it back as its
   * own padding (see directory.css): the text lands exactly where it always
   * did, 12mm in, and the frame is drawn in the 6mm between. A two-up sheet
   * has no frame and keeps the 12mm it has always had.
   *
   * @page cannot be selected on a class, so the choice is made here. Only a
   * book that is one family to a sheet the whole way through qualifies — a
   * combined book may hold churches that set it differently.
   */
  const allSingle = pages.length > 0 && pages.every(function (p) { return p.single; });
%>
<style>@page { size: A4 portrait; margin: <%= allSingle ? '6mm' : '12mm' %>; }</style>
</head>
<%
  // The parish's saved palette overrides the defaults in directory.css.
  const palette = [
    '--band: '      + settings.color_band,
    '--band-dark: ' + settings.color_band_dark,
    '--member-a: '  + settings.color_member_a,
    '--member-b: '  + settings.color_member_b,
    '--rule: '      + settings.color_rule
  ].join('; ');
%>
<body class="directory directory-body" style="<%= palette %>">

<div class="dir-toolbar">
  <strong><%= settings.directory_title %></strong>
  <span>
    <%= total %> <%= total === 1 ? 'family' : 'families' %>,
    <%= pages.length %> <%= pages.length === 1 ? 'page' : 'pages' %><%
    %><% if (includeDrafts) { %> — including drafts<% } %>.
  </span>

  <input type="search" id="dir-search" class="dir-search" placeholder="Search by name, group or place…" aria-label="Search families">
  <span id="dir-search-count" class="dir-search-count" role="status" aria-live="polite" hidden></span>

  <span class="spacer"></span>

  <% if (canEdit) { %>
    <% if (includeDrafts) { %>
      <a class="ghost" href="<%= base %>/directory">Published only</a>
    <% } else { %>
      <a class="ghost" href="<%= base %>/directory?drafts=1">Preview with drafts</a>
    <% } %>
  <% } %>
  <a class="ghost" href="<%= base %>/">Back to the app</a>
  <button type="button" onclick="window.print()">Print this directory</button>
</div>

<% if (!pages.length) { %>
  <div class="page" style="min-height:0">
    <p style="text-align:center;padding:60px 20px;color:#8d8577">
      There are no families in the directory yet.
      <% if (canEdit) { %><br><a href="<%= base %>/families/new">Add the first one</a>.<% } %>
    </p>
  </div>
<% } %>

<p id="dir-search-empty" class="dir-search-empty" hidden>No families match your search.</p>

<%
  /*
   * The edition, which is the year the book is printed.
   *
   * Taken from the clock rather than from a setting: it marks the copy in
   * somebody's hands, and a parish that reprints the directory next February
   * should get "2027" on it without having to remember to go and change a
   * field first. A date is the one thing a computer can be trusted to know.
   */
  const edition = new Date().getFullYear() + ' Edition';
%>
<% pages.forEach(function (page) { %>
  <div class="page<%= page.single ? ' page-single' : '' %>">

    <%
      /*
       * The masthead, on every sheet. A loose leaf out of a printed book
       * should still say which book it came from and which year it is — and
       * the foot of the page, where that used to be, is the wrong end to find
       * it when the sheets are spread on a table.
       */
    %>
    <div class="masthead">
      <div class="masthead-row">
        <div>
          <span class="eyebrow"><%= settings.directory_title %></span>
          <h1><%= settings.parish_name %><%
            %><% if (church && church.city) { %> &middot; <%= church.city %><% } %></h1>
        </div>
        <span class="edition"><%= edition %></span>
      </div>
    </div>

    <div class="entries">
      <% page.families.forEach(function (f, i) { %>
        <%# A struck rule with a gilt point between two families on one sheet. %>
        <% if (i > 0) { %><div class="entry-divider"><span class="dot"></span></div><% } %>
        <%- include('_entry', { f: f, settings: settings, church: church }) %>
      <% }); %>
    </div>

    <div class="page-foot">
      <div class="foot-row">
        <span class="parish-name">
          <%= settings.parish_name %><%
          %><% if (church && church.city) { %> <span class="sep">&middot;</span> <%= church.city %><% } %>
        </span>
        <span class="folio">Page <%= page.folio %></span>
      </div>
    </div>
  </div>
<% }); %>

<script>
(function () {
  var input = document.getElementById('dir-search');
  var empty = document.getElementById('dir-search-empty');
  var count = document.getElementById('dir-search-count');
  if (!input) return;

  var pages = Array.prototype.slice.call(document.querySelectorAll('.page'));

  /*
   * Marking the hits.
   *
   * The search itself reads the flattened data-search attribute, but a reader
   * scanning a matched entry still has to find the word on the page — so the
   * term is wrapped in <mark> where it shows in the entry.
   *
   * Only the parts holding a family's own words are marked, never the printed
   * labels beside them: a short term would otherwise light up "Residence" and
   * "Occupation" in every entry on the page. Entries that carry a mark are
   * remembered so the next keystroke unwraps those alone, which keeps a long
   * book from being rewritten letter by letter.
   *
   * The list is the four places a searched word can actually be: the head's
   * name, the Family ID, the prayer group, the three "where" answers, and the
   * member names down the first column of the table.
   */
  var MARKABLE = '.p-name, .fam-id, .prayer, .ir-value, .members tbody td:first-child';
  var marked = [];

  function unmark() {
    marked.forEach(function (entry) {
      var hits = entry.querySelectorAll('mark.dir-hit');
      Array.prototype.forEach.call(hits, function (hit) {
        var parent = hit.parentNode;
        parent.replaceChild(document.createTextNode(hit.textContent), hit);
        parent.normalize();
      });
    });
    marked = [];
  }

  function mark(entry, term) {
    var texts = [];

    Array.prototype.forEach.call(entry.querySelectorAll(MARKABLE), function (cell) {
      var walker = document.createTreeWalker(cell, NodeFilter.SHOW_TEXT, null, false);
      var node;
      while ((node = walker.nextNode())) {
        if (node.nodeValue.toLowerCase().indexOf(term) !== -1) texts.push(node);
      }
    });
    if (!texts.length) return;

    texts.forEach(function (text) {
      var value = text.nodeValue;
      var lower = value.toLowerCase();
      var frag = document.createDocumentFragment();
      var at = 0;
      var hit;

      while ((hit = lower.indexOf(term, at)) !== -1) {
        if (hit > at) frag.appendChild(document.createTextNode(value.slice(at, hit)));
        var el = document.createElement('mark');
        el.className = 'dir-hit';
        el.textContent = value.slice(hit, hit + term.length);
        frag.appendChild(el);
        at = hit + term.length;
      }
      if (at < value.length) frag.appendChild(document.createTextNode(value.slice(at)));

      text.parentNode.replaceChild(frag, text);
    });

    marked.push(entry);
  }

  input.addEventListener('input', function () {
    var term = input.value.trim().toLowerCase();
    var families = 0;
    var visiblePages = 0;

    unmark();

    pages.forEach(function (page) {
      var entries = page.querySelectorAll('.entry');
      if (!entries.length) return; // the "no families yet" placeholder page

      var pageHasMatch = false;
      Array.prototype.forEach.call(entries, function (entry) {
        var match = !term || (entry.dataset.search || '').indexOf(term) !== -1;
        entry.hidden = !match;
        if (match) {
          pageHasMatch = true;
          families++;
          if (term) mark(entry, term);
        }
      });

      page.hidden = !pageHasMatch;
      if (pageHasMatch) visiblePages++;
    });

    empty.hidden = visiblePages > 0 || !term;

    if (count) {
      count.hidden = !term;
      count.textContent = families === 0 ? 'No results found'
        : families === 1 ? '1 result found'
        : families + ' results found';
    }
  });
})();
</script>

</body>
</html>
