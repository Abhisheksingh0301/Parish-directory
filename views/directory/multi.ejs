<!DOCTYPE html>
<html lang="en">
<head>
<%- include('../partials/head-assets') %>
<title><%= title %></title>
<link rel="stylesheet" href="<%= base %>/stylesheets/directory.css">
<%
  /*
   * The paper.
   *
   * US Letter, 8.5 x 11in, which is the sheet the approved mockup is drawn on
   * and the sheet every measurement in directory.css is now derived from —
   * the eight column widths in particular add up against a 7.3in table and
   * would have to be re-derived on any other size.
   *
   * No margin at all: `.page` carries the mockup's own 0.42in / 0.6in / 0.36in
   * as padding, so the sheet sets its own margin and there is nothing here for
   * @page to add on top. Every edge of that padding clears the ~5mm a printer
   * cannot reach.
   *
   * It no longer varies by layout. It used to give 6mm on a book of one-family
   * sheets so the keyline had somewhere to sit and 12mm otherwise; with the
   * margin inside the sheet, the keyline is simply inset from the padding and
   * both books want the same paper.
   */
%>
<style>@page { size: 8.5in 11in; margin: 0; }</style>
</head>
<body class="directory directory-body">

<div class="dir-toolbar">
  <strong><%= title %></strong>
  <span>
    <%= sections.length %> <%= sections.length === 1 ? 'church' : 'churches' %>,
    <%= totalFamilies %> <%= totalFamilies === 1 ? 'family' : 'families' %>,
    <%= totalPages %> <%= totalPages === 1 ? 'page' : 'pages' %>.
  </span>

  <span class="spacer"></span>

  <a class="ghost" href="<%= base %>/super/reports<%= query %>">Change selection</a>
  <a class="ghost" href="<%= base %>/super">Back to the console</a>
  <button type="button" onclick="window.print()">Print this directory</button>
</div>

<% if (!sections.length) { %>
  <div class="page" style="min-height:0">
    <p style="text-align:center;padding:60px 20px;color:#8d8577">
      Nothing to print — no church in this selection has a published family.
    </p>
  </div>
<% } %>

<%
  /*
   * Each church prints in its own colours.
   *
   * The palette is five CSS custom properties, and custom properties inherit,
   * so declaring them on the section rather than on <body> gives every entry
   * inside it that parish's own scheme. A combined book therefore needs no
   * compromise palette and no change to directory.css beyond the section
   * wrapper itself — each church's pages look exactly like the book that
   * church prints for itself.
   */
%>
<%
  // The year of printing, on every sheet. See the note in print.ejs.
  const edition = new Date().getFullYear() + ' Edition';
%>
<% sections.forEach(function (section) { %>
  <%
    const palette = [
      '--band: '      + section.settings.color_band,
      '--band-dark: ' + section.settings.color_band_dark,
      '--member-a: '  + section.settings.color_member_a,
      '--member-b: '  + section.settings.color_member_b,
      '--rule: '      + section.settings.color_rule
    ].join('; ');
  %>
  <section class="church-section" style="<%= palette %>">
    <div class="page">
      <div class="section-title">
        <h2><%= section.settings.parish_name %></h2>
        <p>
          <% if (section.church.city) { %><%= section.church.city %> · <% } %>
          <% if (section.church.zone_name) { %><%= labels.zone %>: <%= section.church.zone_name %> · <% } %>
          <%= labels.diocese %>: <%= section.church.diocese_name %>
        </p>
        <p class="count">
          <%= section.families %> <%= section.families === 1 ? 'family' : 'families' %>
        </p>
      </div>
    </div>

    <% section.pages.forEach(function (page) { %>
      <div class="page<%= page.single ? ' page-single' : '' %>">

        <%# Each church's own masthead, so a leaf out of the combined book
            still names the parish it belongs to rather than the volume. %>
        <div class="masthead">
          <div class="masthead-row">
            <div>
              <span class="eyebrow"><%= section.settings.directory_title %></span>
              <h1><%= section.settings.parish_name %><%
                %><% if (section.church.city) { %> &middot; <%= section.church.city %><% } %></h1>
            </div>
            <span class="edition"><%= edition %></span>
          </div>
        </div>

        <div class="entries">
          <% page.families.forEach(function (f, i) { %>
            <% if (i > 0) { %><div class="entry-divider"><span class="dot"></span></div><% } %>
            <%- include('_entry', { f: f, settings: section.settings, church: section.church }) %>
          <% }); %>
        </div>

        <div class="page-foot">
          <div class="foot-row">
            <span class="parish-name">
              <%= section.settings.parish_name %><%
              %><% if (section.church.city) { %> <span class="sep">&middot;</span> <%= section.church.city %><% } %>
            </span>
            <span class="folio">Page <%= page.folio %></span>
          </div>
        </div>
      </div>
    <% }); %>
  </section>
<% }); %>

</body>
</html>
