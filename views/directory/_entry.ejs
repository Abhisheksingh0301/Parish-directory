<%
  /*
   * One family's printed entry.
   *
   * Shared by the single-church book (print.ejs) and the combined one
   * (multi.ejs) so the two can never drift apart.
   *
   * Expects: f (a family with members), settings, church, nl2br.
   *
   * The layout is the 2026 design: the household's name over a gilt rule, the
   * photograph beside a card of the three "where" answers, and the members as
   * a banded table under both. Two of these to an A4 sheet.
   *
   * Two fields that used to print here no longer do, and both moved rather
   * than went:
   *
   *   Prayer Group  is in the eyebrow beside the Family ID, which is where
   *                 somebody looking for a household's group actually reads.
   *   Email ID      the family's own address, which is the one it signs in
   *                 with rather than one the book is for. Each member's own
   *                 address is in the table, which is where a reader looks
   *                 for a person's email.
   *
   * Relation is no longer a column of its own either: it is set in italic
   * beside the name, which reads as "Nibin Babu John (Son)" and gives the
   * column it used to occupy to the addresses, which needed it.
   */
  // Flattened for the on-page search box: name, group, and every "place" field.
  const searchText = [
    f.head_name, f.family_id, f.prayer_group, f.address, f.hometown, f.home_parish
  ].concat(f.members.map(function (m) { return m.name; }))
   .filter(Boolean).join(' ').toLowerCase();
%>
<section class="entry" data-search="<%= searchText %>">

  <div class="p-head">
    <div class="p-eyebrow">
      <span class="fam-id"><%= f.family_id %></span>
      <% if (f.prayer_group) { %>
        <span class="prayer"><%= f.prayer_group %></span>
      <% } %>
    </div>
    <div class="p-name"><%= f.head_name %></div>
    <%# The one ornament an entry gets, and it is a rule rather than a flourish. %>
    <div class="gold-rule"></div>
  </div>

  <div class="p-top">
    <div class="photo-frame">
      <% if (f.photo) { %>
        <img class="photo" src="<%= f.photo_url %>"
             alt="Photograph of the <%= f.head_name %> family">
      <% } else { %>
        <div class="photo photo-empty">Family Photo</div>
      <% } %>
    </div>

    <%
      /*
       * The household's three "where" answers, each named.
       *
       * A missing value is a dash rather than a blank, the same as in the
       * members table below and for the same reason: an empty space in a
       * printed register reads as a question nobody asked, and every one of
       * these was asked. A dash says the household did not answer.
       */
    %>
    <div class="info">
      <div class="info-row">
        <div class="ir-label">Residence</div>
        <div class="ir-value"><% if (f.address) { %><%- nl2br(f.address) %><% } else { %><span class="dash">&mdash;</span><% } %></div>
      </div>
      <div class="info-row">
        <div class="ir-label">Home Parish</div>
        <div class="ir-value"><% if (f.home_parish) { %><%= f.home_parish %><% } else { %><span class="dash">&mdash;</span><% } %></div>
      </div>
      <div class="info-row">
        <div class="ir-label">Home Town</div>
        <div class="ir-value"><% if (f.hometown) { %><%- nl2br(f.hometown) %><% } else { %><span class="dash">&mdash;</span><% } %></div>
      </div>
    </div>
  </div>

  <div class="members-wrap">
    <table class="members">
      <thead>
        <tr>
          <th class="cw-name">Member</th>
          <th class="cw-bday">Birthday</th>
          <th class="cw-anniv">Anniv.</th>
          <th class="cw-mob">Mobile</th>
          <th class="cw-blood c">Blood</th>
          <th class="cw-qual">Qualification</th>
          <th class="cw-occ">Occupation</th>
          <th class="cw-email">Email</th>
        </tr>
      </thead>
      <%
        /*
         * A married couple share one wedding date, so when the second member
         * is the spouse, the Anniv. cell spans both of their rows instead of
         * repeating — matching the guidance the family form itself gives for
         * ordering members. A second member who is a son or daughter instead
         * gets no such cell to share, so nothing merges.
         */
        const mergeAnniv = f.members.length > 1 &&
          String(f.members[1].relation || '').trim().toLowerCase() === 'spouse';
      %>
      <tbody>
        <% f.members.forEach(function (m, i) { %>
          <tr>
            <td>
              <span class="m-name"><%= m.name %><%
                %><% if (m.relation) { %> <span class="rel">(<%= m.relation %>)</span><% } %></span>
            </td>
            <td class="m-mono"><% if (m.dob) { %><%= m.dob %><% } else { %><span class="dash">&mdash;</span><% } %></td>
            <% if (!(mergeAnniv && i === 1)) { %>
              <%
                const anniv = (mergeAnniv && i === 0) ? (m.dom || f.members[1].dom) : m.dom;
              %>
              <td class="m-mono"<% if (mergeAnniv && i === 0) { %> rowspan="2"<% } %>><%
                if (anniv) { %><%= anniv %><% } else { %><span class="dash">&mdash;</span><% } %></td>
            <% } %>
            <%# A member may hold more than one of either, one to a line. Each is
                escaped on its own rather than joined into a blob of markup. %>
            <td class="m-mono"><% if (!m.mobiles.length) { %><span class="dash">&mdash;</span><% } %><%
              %><% m.mobiles.forEach(function (n, j) { %><%
              %><%= n %><% if (j < m.mobiles.length - 1) { %><br><% } %><% }) %></td>
            <%# The one value on the row read at a glance in an emergency, so it
                is the one set apart rather than merely printed. %>
            <td class="c"><% if (m.blood_group) { %><span class="blood-pill"><%= m.blood_group %></span><% } else { %><span class="dash">&mdash;</span><% } %></td>
            <td><% if (m.qualification) { %><%= m.qualification %><% } else { %><span class="dash">&mdash;</span><% } %></td>
            <td><% if (m.occupation) { %><%= m.occupation %><% } else { %><span class="dash">&mdash;</span><% } %></td>
            <td><% if (!m.email_list.length) { %><span class="dash">&mdash;</span><% } %><%
              %><% m.email_list.forEach(function (a, j) { %><%
              %><span class="email"><%= a %></span><% if (j < m.email_list.length - 1) { %><br><% } %><% }) %></td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
</section>
